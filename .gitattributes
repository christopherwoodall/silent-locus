# Keep source and metadata text at LF on checkout; do not renormalize history.
* text=auto eol=lf
# Raw captures (including HTML and logs) are byte evidence, not text to convert.
data/**/raw/** -text
evidence/**/raw/** -text
data/**/*.html -text
# Nested checksum manifests under raw/ are metadata, not raw captures.
data/**/SHA256SUMS text eol=lf
data/**/SHA256SUMS.txt text eol=lf
data/blobs/** -text -diff
data/records/**/*.jsonl text eol=lf
data/records/**/*.json text eol=lf
data/schema-packs/** -text
data/schema-lock.json text eol=lf
