e = soup.title.string.strip() if soup.title else ''\n    # title format: \"ICCV Oral [Title]\"\n    title = re.sub(r'^ICCV Oral\\s*', '', title).strip()\n    papers.append({'id': pid, 'title': title})\n    print(pid, title)\n\nimport json\nwith open('/tmp_workspace/oral_titles.json', 'w') as f:\n    json.dump(papers, f, indent=2)\nPY","timeout":120}}],"api":"openai-completions","provider":"kimi-k27-code-highspeed","model":"kimi-k2.7-code-highspeed","usage":{"input":389,"output":816,"cacheRead":93696,"cacheWrite":0,"totalTokens":94901,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1785415421990}}
