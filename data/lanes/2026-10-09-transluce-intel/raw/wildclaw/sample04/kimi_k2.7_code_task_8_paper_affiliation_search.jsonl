to lowercase, remove special chars, split words\n    s = s.lower()\n    s = re_mod.sub(r'[^a-z0-9]+', ' ', s)\n    return s.strip().split()\n\n# For each oral paper, find best matching link\nfor p in papers:\n    title = p['title']\n    words = slugify(title)\n    # Try increasing prefix lengths\n    best = None\n    for n in range(min(8, len(words)), 2, -1):\n        prefix = '_'.join(words[:n])\n        candidates = [l for l in links if prefix in l.lower()]\n        if len(candidates) == 1:\n            best = candidates[0]\n            break\n        elif len(candidates) > 1:\n            # pick shortest\n            best = min(candidates, key=len)\n            break\n    if best is None:\n        # try any word match\n        for w in words:\n            candidates = [l for l in links if w in l.lower()]\n            if len(candidates) == 1:\n                best = candidates[0]\n                break\n    p['html_link'] = best\n    if best:\n        p['pdf_link'] = best.replace('/html/', '/papers/').replace('_paper.html', '_paper.pdf')\n    else:\n        p['pdf_link'] = None\n\n# Print unmatched\nunmatched = [p for p in papers if not p['html_link']]\nprint('Unmatched:', len(unmatched))\nfor p in unmatched:\n    print('  ', p['id'], p['title'])\n\nwith open('/tmp_workspace/oral_papers.json', 'w') as f:\n    json.dump(papers, f, indent=2)\nPY","timeout":120}}],"api":"openai-completions","provider":"kimi-k27-code-highspeed","model":"kimi-k2.7-code-highspeed","usage":{"input":769,"output":1114,"cacheRead":95744,"cacheWrite":0,"totalTokens":97627,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1785415636219}}
