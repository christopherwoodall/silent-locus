  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "agent_traces",
      "name": "agent_traces",
      "description": "Per-trace records from multi-server MCP agent execution. Each record represents one complete task execution with canary-based propagation labels.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "trace_id",
          "name": "trace_id",
          "description": "Unique trace identifier.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "main_gpt_5_4"
            },
            "extract": {
              "jsonPath": "$.traces[*].trace_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "task_id",
          "name": "task_id",
          "description": "Task identifier from the 147-task registry.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "main_gpt_5_4"
            },
            "extract": {
              "jsonPath": "$.traces[*].task_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "model",
          "name": "model",
          "description": "LLM model identifier.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "main_gpt_5_4"
            },
            "extract": {
              "jsonPath": "$.traces[*].model"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "env_type",
          "name": "env_type",
          "description": "Environment variant: risky_v1/v2/v3, benign, hard_neg_v1/v2/v3.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "main_gpt_5_4"
            },
            "extract": {
              "jsonPath": "$.traces[*].env_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "risk_mechanism",
          "name": "risk_mechanism",
          "description": "Mechanism family: file_to_file, browser_to_local, etc.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "main_gpt_5_4"
            },
            "extract": {
              "jsonPath": "$.traces[*].risk_mechanism"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "risk_type",
          "name": "risk_type",
          "description": "Control type: risk, benign, hard_negative.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "main_gpt_5_4"
            },
            "extract": {
              "jsonPath": "$.traces[*].risk_type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "outcome",
          "name": "outcome",
          "description": "Outcome classification: safe_success, unsafe_success, safe_failure, unsafe_failure.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "main_gpt_5_4"
            },
            "extract": {
              "jsonPath": "$.traces[*].outcome"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "task_completed",
          "name": "task_completed",
          "description": "Whether the agent completed the requested task.",
          "dataType": "sc:Boolean",
          "source": {
            "fileObject": {
              "@id": "main_gpt_5_4"
            },
            "extract": {
              "jsonPath": "$.traces[*].task_completed"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "num_events",
          "name": "num_events",
          "description": "Number of tool-call events in the trace.",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "main_gpt_5_4"
            },
            "extract": {
              "jsonPath": "$.traces[*].num_events"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "num_turns",
          "name": "num_turns",
          "description": "Number of LLM turns.",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "main_gpt_5_4"
            },
            "extract": {
              "jsonPath": "$.traces[*].num_turns"
            }
          }
        },
        {
          "@type": "cr:Field",
