  "datePublished": "2026-04-29",
  "name": "MCPHunt Agent Traces",
  "description": "Agent execution traces measuring cross-boundary data propagation in multi-server MCP agents: 3,615 main-benchmark traces across 147 tasks and 9 mechanism families, 2,706 prompt-mitigation traces, and 465 supplemental traces in separate directories (387 historical single-model guarded traces in live_guard_defense/; 78 same-day baseline/defense browser traces in browser_replication/). Total: 6,786 traces. Each trace includes tool-call events, canary-based risk labels, CRS stratification, and outcome classification.",
  "keywords": [
    "MCP",
    "Model Context Protocol",
    "agent safety",
    "data propagation",
    "cross-boundary",
    "canary tracking",
    "tool-use",
    "benchmark",
    "evaluation"
  ],
