 "behaviors": [
  {
   "text": "In November 2022, Randal \"Quran\" Reid was arrested in Georgia based on warrants from Louisiana that reportedly stemmed from a purportedly faulty facial recognition match using Clearview AI.",
   "slug_or_none": "none-established",
   "report_ids": [
    2905,
    2916,
    5342
   ]
  },
  {
   "text": "Despite reportedly having never visited Louisiana, Reid was jailed for six days before authorities withdrew the warrants.",
   "slug_or_none": "none-established",
   "report_ids": [
    2905,
    2916,
    5342
   ]
  },
  {
   "text": "No corroborating evidence had been gathered, and the technology's use was omitted from legal documents.",
   "slug_or_none": "none-established",
   "report_ids": [
    2905,
    2916,
    5342
   ]
  },
  {
   "text": "In May 2025, Jefferson Parish settled with Reid for $200,000 in a federal civil rights lawsuit.",
   "slug_or_none": "none-established",
   "report_ids": [
    2905,
    2916,
    5342
   ]
  }
 ],
