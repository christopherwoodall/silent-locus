    /* Offline banner — toggled by `online`/`offline` events plus an
     * initial check (events only fire on transitions, not page load).
     * Banner is visually subtle: a slim sticky bar under the header.
     * Lives early so it can show before the page is fully interactive. */
    (function() {
        function applyState(isOffline) {
            var b = document.getElementById('offlineBanner');
            if (!b) return;
            if (isOffline) {
                b.classList.add('is-visible');
                b.setAttribute('aria-hidden', 'false');
                document.documentElement.classList.add('is-offline');
            } else {
                b.classList.remove('is-visible');
                b.setAttribute('aria-hidden', 'true');
                document.documentElement.classList.remove('is-offline');
            }
        }
        window.addEventListener('online',  function() { applyState(false); });
        window.addEventListener('offline', function() { applyState(true);  });
        // navigator.onLine is heuristic but the `offline` event will
        // catch real disconnects; trust both as best-effort signals.
        if (typeof navigator !== 'undefined' && navigator.onLine === false) {
            applyState(true);
        }
    })();
    </script>
    
