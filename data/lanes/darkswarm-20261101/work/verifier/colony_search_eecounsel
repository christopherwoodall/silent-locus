parents_looked_up\"]), (None, 0))\n+\n+    def test_short_list_gives_no_false_orphans(self):\n+        # The ids a short read lists are not all the post holds, so a missing parent is asked for by id before it\n+        # is called gone. Post P counts 9 comments and lists 6: m2, b1 and m3 are missing. A deleted comment\n+        # leaves every listing and its count (Rosetta, aa5ac4e8), so x410 is in neither.\n+        m1 = c(\"m1\", \"P\", \"ember\", \"2026-08-09T00:00:00Z\")\n+        m2 = c(\"m2\", \"P\", \"ember\", \"2026-08-09T01:00:00Z\")  # in ember's history, not in the list\n+        b1 = c(\"b1\", \"P\", \"bytes\", \"2026-08-09T02:00:00Z\")  # served by id, not in the list\n+        m3 = c(\"m3\", \"P\", \"ember\", \"2026-08-09T03:00:00Z\")  # served by id, in neither (a short history too)\n+        k1 = c(\"k1\", \"P\", \"kavi\", T, parent=\"m2\")\n+        k2 = c(\"k2\", \"P\", \"kavi\", T, parent=\"b1\")\n+        k3 = c(\"k3\", \"P\", \"kavi\", T, parent=\"x410\")\n+        k4 = c(\"k4\", \"P\", \"kavi\", \"2026-08-10T11:00:00Z\", parent=\"x410\")\n+        k5 = c(\"k5\", \"P\", \"kavi\", T, parent=\"m3\")\n+        get = fake([m1, m2], [], {\"P\": [m1, k1, k2, k3, k4, k5]}, totals={\"P\": 9}, hidden=[m2, b1, m3],\n+                   deleted={\"x410\"})\n+        res = owed.collect(get, \"ember\")\n+        self.assertEqual({r[\"comment_id\"]: (r[\"why\"], r[\"parent_state\"]) for r in res[\"rows\"]},\n+                         {\"k1\": (\"reply-to-you\", None), \"k5\": (\"reply-to-you\", None),\n+                          \"k3\": (\"orphan-parent\", \"410\"), \"k4\": (\"orphan-parent\", \"410\")})\n+        # m2 came from the history, so it was not asked for; x410 was asked for once, for both its children\n+        self.assertEqual(sorted(p for p in get.calls if p.startswith(\"/comments/\")),\n+                         [\"/comments/b1\", \"/comments/m3\", \"/comments/x410\"])\n+        self.assertEqual(res[\"parents_looked_up\"], 3)\n+        self.asse