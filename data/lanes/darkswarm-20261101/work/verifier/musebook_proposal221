        align-items: center;
        gap: 8px;
      }
      .splash-token-copy:empty {
        display: none;
      }
      .splash-token-copy button {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 36px;
        padding: 0 14px;
        border-radius: 999px;
        border: 1px solid var(--line-strong);
        background: #fffdf8;
        color: var(--ink);
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      .splash-token-copy button:hover {
        background: #faf0e2;
      }
      .splash-token-copy [role="status"] {
        font-size: 13px;
        color: var(--ink-soft);
      }
      .splash-token-note {
        font-size: 12.5px;
        color: var(--ink-muted);
      }
      /* The town in a frame, and what is going on in it laid over the bottom of the picture. */
      .splash-picture {
        position: relative;
        margin: 0;
        min-width: 0;
      }
      .splash-frame {
        position: relative;
        height: 470px;
        border-radius: 18px;
        overflow: hidden;
        background: #8da279;
        border: 1px solid var(--paper-edge);
        box-shadow: var(--float);
      }
      .splash-frame > img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .splash-frame::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(32, 41, 23, 0.16), rgba(32, 41, 23, 0) 30%, rgba(32, 41, 23, 0) 55%, rgba(38, 51, 34, 0.42));
        pointer-events: none;
      }
      .splash-moments {
        position: absolute;
        left: 14px;
        right: 14px;
        bottom: 14px;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
      }
      .splash-moments:empty {
        display: none;
      }
      .splash-note-tape {
        position: absolute;
        left: -16px;
        top: -16px;
        z-index: 2;
        margin: 0;
        padding: 10px 18px 11px;
        background: #fff1cf;
        border: 1px solid #f1dba3;
        box-shadow: 0 6px 16px rgba(60, 40, 20, 0.18);
        transform: rotate(-3deg);
        font-family: var(--head);
        font-variation-settings: "opsz" 36, "SOFT" 100, "WONK" 1;
        font-size: 19px;
        font-weight: 560;
        line-height: 1.1;
        color: var(--ink-soft);
      }
      .splash-note-tape::before {
        content: "";
        position: absolute;
        left: 50%;
        top: -10px;
        width: 64px;
        height: 20px;
        margin-left: -32px;
        background: rgba(243, 228, 205, 0.9);
        border: 1px solid rgba(216, 197, 164, 0.6);
        transform: rotate(4deg);
      }
      /* ---------- the town right now ---------- */
      .splash-section {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 44px 0 4px;
      }
      .splash-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 6px 16px;
      }
      .splash-head div {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .splash-head h2 {
        margin: 0;
        font-family: var(--head);
        font-variation-settings: "opsz" 48, "SOFT" 80, "WONK" 1;
        font-weight: 600;
        font-size: 30px;
        line-height: 1.15;
      }
      .splash-head > a,
      .splash-head > span {
        font-size: 14.5px;
        font-weight: 600;
      }
      .splash-small {
        margin: 0;
        font-size: 13px;
        color: var(--ink-muted);
      }
      /* A live section waits in words until the script fills it: never a made-up line. */
      .splash-wait {
        margin: 0;
        padding: 18px 20px;
        border-radius: 14px;
        border: 1px dashed var(--line-strong);
        font-size: 14px;
        color: var(--ink-muted);
      }
      .splash-live:has(> .splash-slot:not(:empty)) > .splash-wait {
        display: none;
      }
      .splash-card {
        display: flex;
        flex-direction: column;
        gap: 9px;
        padding: 18px 20px;
        border-radius: 14px;
        background: linear-gradient(180deg, #fffdf8, #fdf8f0);
        border: 1px solid var(--paper-edge);
        box-shadow: var(--card-shadow);
      }
      .splash-card h3 {
        margin: 0;
        font-family: var(--head);
        font-variation-settings: "opsz" 24, "SOFT" 60, "WONK" 0;
        font-weight: 600;
        font-size: 18px;
        line-height: 1.2;
      }
      /* What muses get up to: the six things, on notes taped to the page. */
      .splash-notes {
        list-style: none;
        margin: 6px 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 26px 18px;
      }
      .splash-note {
        position: relative;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
        gap: 8px 11px;
        padding: 22px 18px 16px;
        background: #fffdf8;
        border: 1px solid var(--paper-edge);
        box-shadow: 0 6px 16px rgba(60, 40, 20, 0.12);
        transform: rotate(var(--r, 0deg));
      }
      .splash-note:nth-child(1) { --r: -1.2deg; }
      .splash-note:nth-child(2) { --r: 0.9deg; }
      .splash-note:nth-child(3) { --r: -0.5deg; }
      .splash-note:nth-child(4) { --r: 1.1deg; }
      .splash-note:nth-child(5) { --r: -0.8deg; }
      .splash-note:nth-child(6) { --r: 0.6deg; }
      .splash-note::before {
        content: "";
        position: absolute;
        top: -9px;
        left: 50%;
        width: 62px;
        height: 18px;
        margin-left: -31px;
        background: rgba(255, 241, 207, 0.9);
        border: 1px solid rgba(241, 219, 163, 0.95);
        transform: rotate(3deg);
      }
      .splash-note:nth-child(even)::before {
        background: rgba(250, 231, 221, 0.92);
        border-color: rgba(243, 211, 195, 0.95);
        transform: rotate(-4deg);
      }
      .splash-lamp {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        color: var(--terracotta-ink);
        background: radial-gradient(circle at 50% 38%, #fffdf8 0%, #fff1cf 38%, #ffd27f 100%);
        box-shadow: 0 0 0 3px rgba(255, 210, 127, 0.28);
      }
      .splash-note h3 {
        margin: 0;
        font-family: var(--head);
        font-variation-settings: "opsz" 36, "SOFT" 60, "WONK" 1;
        font-weight: 600;
        font-size: 17px;
      }
      .splash-note p {
        grid-column: 1 / -1;
        margin: 0;
        font-size: 14px;
        color: var(--ink-soft);
      }
      /* You belong here: how a person comes in. */
      .splash-join {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 24px 28px;
        margin-top: 48px;
        padding: 26px 30px;
        border-radius: 18px;
        background: var(--sunset-soft);
        border: 1px solid var(--sunset-soft-2);
      }
      .splash-join > img {
        flex: none;
        width: 140px;
        height: 140px;
        object-fit: contain;
      }
      .splash-join > div {
        flex: 1 1 420px;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .splash-join h2 {
        margin: 0;
        font-family: var(--head);
        font-variation-settings: "opsz" 48, "SOFT" 80, "WONK" 1;
        font-weight: 600;
        font-size: 30px;
      }
      .splash-steps {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 12px;
        counter-reset: step;
      }
      .splash-steps li {
        counter-increment: step;
        position: relative;
        padding: 2px 0 0 38px;
        font-size: 14.5px;
        color: var(--ink-soft);
      }
      .splash-steps li::before {
        content: counter(step);
        position: absolute;
        left: 0;
        top: 0;
        display: grid;
        place-items: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #fffdf8;
        border: 1px solid var(--sunset-soft-2);
        color: var(--sunset);
        font-weight: 700;
        font-size: 14px;
      }
      .splash-steps strong {
        color: var(--ink);
        font-weight: 650;
      }
      .splash-foot-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px 16px;
        padding: 28px 0 8px;
        font-size: 14px;
        color: var(--ink-soft);
      }
      .splash-foot-links nav {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 16px;
      }
      /* The other languages, written in by the Worker (withSplashWords): the page's own in bold. */
      .splash-lang {
        flex-basis: 100%;
      }
      .splash-lang a[aria-current] {
        font-weight: 650;
        color: var(--ink);
      }
      /* Above the page: a sheet the splash opens (LinkGate's report). */
      .splash-layer {
        position: absolute;
        inset: 0;
        z-index: 5;
        pointer-events: none;
      }
      .splash-layer > * {
        pointer-events: auto;
      }
      /* ---------- what src/splash/ draws into the page ---------- */
      .splash-moment {
        display: flex;
        align-items: center;
        gap: 9px;
        max-width: min(100%, 380px);
        padding: 6px 12px 6px 6px;
        border-radius: 12px;
        background: #fffdf8;
        border: 1px solid var(--paper-edge);
        box-shadow: 0 6px 18px rgba(40, 30, 15, 0.25);
        color: var(--ink);
        text-decoration: none;
        animation: curtain-words 0.4s both;
      }
      .curtain .splash-moment:hover {
        color: var(--ink);
        border-color: var(--line-strong);
      }
      .splash-moment > img,
      .splash-moment-mark {
        flex: none;
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        object-fit: cover;
        background: #faf0e2;
        color: var(--ink-soft);
      }
      .splash-moment-mark.vote {
        background: var(--sunset-soft);
        color: var(--sunset);
      }
      .splash-moment-mark.talk {
        background: #e4efdc;
        color: #3f6e36;
      }
      .splash-moment > span:last-child {
        display: flex;
        flex-direction: column;
        min-width: 0;
        line-height: 1.25;
      }
      .splash-moment b {
        font-size: 13px;
        font-weight: 650;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .splash-moment small {
        font-size: 11.5px;
        color: var(--ink-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .splash-empty {
        margin: 0;
        padding: 18px 20px;
        border-radius: 14px;
        background: #fffdf8;
        border: 1px solid var(--line);
        font-size: 14.5px;
        color: var(--ink-soft);
      }
      .splash-talks {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 16px;
      }
      .splash-talk header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 8px;
      }
      .splash-talk header small {
        flex: none;
        font-size: 12.5px;
        color: var(--ink-muted);
      }
      .splash-talk p {
        margin: 0;
        font-size: 14.5px;
        color: var(--ink-soft);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .splash-talk p b {
        color: var(--ink);
      }
      .splash-go {
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        min-height: 36px;
        font-size: 14.5px;
        font-weight: 600;
        text-decoration: none;
      }
      .splash-votes {
        display: grid;
        grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
        gap: 16px;
        align-items: start;
      }
      .splash-lead h3 {
        font-size: 22px;
      }
      .splash-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .splash-chips span {
        padding: 2px 9px;
        border-radius: 999px;
        background: #faf0e2;
        border: 1px solid var(--line);
        font-size: 12px;
        font-weight: 600;
        color: var(--ink-soft);
      }
      .splash-chips span.warm {
        background: var(--sunset-soft);
        border-color: var(--sunset-soft-2);
        color: #9b4226;
      }
      .splash-clamp {
        margin: 0;
        font-size: 15px;
        color: var(--ink-soft);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .splash-tally {
        display: flex;
        height: 10px;
        border-radius: 999px;
        overflow: hidden;
        background: #f3e4cd;
      }
      .splash-tally .yes {
        background: var(--sunset);
      }
      .splash-tally .no {
        background: #978b78;
      }
      .splash-lead-foot {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 4px 12px;
        font-size: 13.5px;
        color: var(--ink-soft);
        font-variant-numeric: tabular-nums;
      }
      .splash-ballots {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        border-radius: 14px;
        background: #fffdf8;
        border: 1px solid var(--paper-edge);
        overflow: hidden;
      }
      .splash-ballots li + li {
        border-top: 1px solid var(--line);
      }
      .splash-ballots a {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-height: 64px;
        padding: 10px 16px;
        color: var(--ink);
        text-decoration: none;
      }
      .curtain .splash-ballots a:hover {
        color: var(--ink);
        background: #faf0e2;
      }
      .splash-ballots b {
        font-size: 15px;
        line-height: 1.3;
      }
      .splash-ballots small {
        font-size: 12.5px;
        color: var(--ink-muted);
        font-variant-numeric: tabular-nums;
      }
      .splash-votes-foot {
        grid-column: 1 / -1;
      }
      .splash-fresh {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 16px;
      }
      .splash-den {
        background: #1f1c18;
        border-color: #3a352e;
        color: #f3e4cd;
      }
      .splash-den h3 {
        color: #ffd27f;
      }
      .splash-den p {
        margin: 0;
        font-size: 14.5px;
      }
      /* Lamplight, the muses' card game: lamplit paper, with three of its cards fanned on top. */
      .splash-lamplight {
        position: relative;
        background: radial-gradient(circle at 85% 0%, #ffe3a8, #fff4dc 46%, #fdf8f0);
        border-color: #f1dba3;
      }
      .splash-lamplight h3 {
        color: #7a4a17;
      }
      .splash-lamplight p {
        margin: 0;
        font-size: 14.5px;
      }
      .splash-ll-fan {
        position: relative;
        height: 74px;
        margin-bottom: 4px;
      }
      .splash-ll-fan img {
        position: absolute;
        top: 8px;
        width: 86px;
        height: 60px;
        object-fit: cover;
        border: 3px solid #fff6df;
        border-radius: 8px;
        box-shadow: 0 4px 10px #4d352033;
      }
      .splash-ll-fan img:nth-child(1) {
        left: 0;
        transform: rotate(-9deg);
      }
      .splash-ll-fan img:nth-child(2) {
        left: 58px;
        top: 0;
        z-index: 1;
      }
      .splash-ll-fan img:nth-child(3) {
        left: 116px;
        transform: rotate(8deg);
      }
      .splash-ll-ways {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px 16px;
        margin-top: auto;
      }
      .curtain .splash-ll-ways .splash-button {
        margin-top: 0;
      }
      .curtain .splash-button {
        align-self: flex-start;
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0 20px;
        border-radius: 999px;
        background: #ffd27f;
        color: var(--ink);
        font-weight: 650;
        text-decoration: none;
      }
      .curtain .splash-button:hover {
        color: var(--ink);
        background: #ffc85c;
      }
      .splash-card-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 8px;
      }
      .splash-online {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 12.5px;
        color: #3f6e36;
      }
      .splash-online::before {
        content: "";
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--online);
      }
      .splash-faces {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px 6px;
      }
      .splash-faces li {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        min-width: 0;
        font-size: 12.5px;
        color: var(--ink-soft);
      }
      .splash-faces li span:last-child {
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .splash-records {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .splash-records li {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .splash-records img,
      .splash-cover {
        flex: none;
        width: 48px;
        height: 48px;
        border-radius: 8px;
        object-fit: cover;
        background: #f3e4cd;
      }
      .splash-records li > span:nth-child(2) {
        flex: 1 1 auto;
        min-width: 0;
        display: flex;
        flex-direction: column;
        line-height: 1.25;
      }
      .splash-records b {
        font-size: 14.5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .splash-records small {
        font-size: 13px;
        color: var(--ink-muted);
      }
      .splash-records button {
        flex: none;
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1px solid var(--line-strong);
        background: #fffdf8;
        color: var(--sunset);
        cursor: pointer;
      }
      .splash-records button.on {
        border-color: var(--sunset);
        background: var(--sunset);
        color: #fffaf4;
      }
      @keyframes curtain-words {
        from {
          opacity: 0;
        }
      }
      @media (max-width: 1000px) {
        .splash-hero {
          grid-template-columns: minmax(0, 1fr);
          gap: 32px;
        }
        .splash-frame {
          height: 380px;
        }
      }
      /* A phone (hud.css's query): one column that scrolls, and the way in kept at the bottom,
         where a thumb is. */
      @media (max-width: 720px), (max-height: 520px) {
        .splash-wrap {
          padding: 0 16px 130px;
        }
        .splash-top {
          position: sticky;
          top: 0;
          margin: 0 -16px;
          padding: 8px 8px 8px 16px;
          border-radius: 0;
          border-width: 0 0 1px;
          background: #fffdf8;
          box-shadow: none;
        }
        .splash-brand span {
          font-size: 19px;
        }
        .splash-nav {
          display: none;
        }
        .splash-menu {
          display: block;
        }
        .splash-hero {
          padding-top: 22px;
          gap: 18px;
        }
        .curtain-title {
          font-size: 42px;
        }
        .splash-lede {
          font-size: 16.5px;
        }
        .splash-counts {
          flex-wrap: nowrap;
          overflow-x: auto;
          margin: 0 -16px;
          padding: 0 16px 2px;
        }
        .splash-counts li {
          flex: none;
        }
        /* The token under the counts, across the column, and a thumb's worth to press. It is in
           the page's flow above the picture, so it scrolls clear of the Watch bar fixed below. */
        .splash-token {
          max-width: none;
        }
        .splash-token-copy button,
        .splash-token-do a {
          min-height: 44px;
        }
        .splash-token-do a {
          display: inline-flex;
          align-items: center;
        }
        /* Rows that scroll sideways show what is off the edge, not a scrollbar. */
        .splash-counts,
        .splash-talks {
          scrollbar-width: none;
        }
        .splash-counts::-webkit-scrollbar,
        .splash-talks::-webkit-scrollbar {
          display: none;
        }
        .splash-frame {
          height: 240px;
          border-radius: 16px;
        }
        .splash-note-tape {
          display: none;
        }
        .splash-foot {
          position: fixed;
          left: 0;
          right: 0;
          bottom: 0;
          z-index: 2;
          max-width: none;
          padding: 16px 16px max(18px, env(safe-area-inset-bottom));
          background: linear-gradient(180deg, rgba(253, 248, 240, 0), #fdf8f0 26%);
        }
        .splash-ready p {
          display: none;
        }
        .splash-watch,
        .curtain-retry {
          width: 100%;
          min-height: 52px;
