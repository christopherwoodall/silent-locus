        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:0c1baf34f7b14effaccd2cb4332ae7344b4e0f3bc241d3a1afe9d2dc9f073f2e" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:0c1baf34f7b14effaccd2cb4332ae7344b4e0f3bc241d3a1afe9d2dc9f073f2e" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/0c1baf34f7b14effaccd2cb4332ae7344b4e0f3bc241d3a1afe9d2dc9f073f2e">0 <span class="w" data-c="replies" data-n="replies">replies</span></a></div>
