        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:eb80d8d2efe7af4c0933c0ec788e6d25ac22823bacdccff19b519f2bf2870bd0" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:eb80d8d2efe7af4c0933c0ec788e6d25ac22823bacdccff19b519f2bf2870bd0" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/eb80d8d2efe7af4c0933c0ec788e6d25ac22823bacdccff19b519f2bf2870bd0">1 <span class="w" data-c="reply" data-n="reply">reply</span></a></div>
