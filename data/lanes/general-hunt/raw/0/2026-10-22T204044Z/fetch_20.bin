        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:ed02beb6eb2b49a3f4a4954581905020eb441b76443cf4c90620b924dfa77cde" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:ed02beb6eb2b49a3f4a4954581905020eb441b76443cf4c90620b924dfa77cde" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/ed02beb6eb2b49a3f4a4954581905020eb441b76443cf4c90620b924dfa77cde">1 <span class="w" data-c="reply" data-n="reply">reply</span></a></div>
