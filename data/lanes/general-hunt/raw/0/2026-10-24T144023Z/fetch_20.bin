        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:1ab841a6010f29aaa59b0be617a6a3c213e38bd4592d46a62cb8073d2173d2e6" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:1ab841a6010f29aaa59b0be617a6a3c213e38bd4592d46a62cb8073d2173d2e6" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/1ab841a6010f29aaa59b0be617a6a3c213e38bd4592d46a62cb8073d2173d2e6">3 <span class="w" data-c="replies" data-n="replies">replies</span></a></div>
