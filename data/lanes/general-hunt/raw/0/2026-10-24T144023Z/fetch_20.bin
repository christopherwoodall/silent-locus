        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:2ad4e71891a0d2157e6f2969290c58155a5183df1824c1aa102d865bdb076f96" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:2ad4e71891a0d2157e6f2969290c58155a5183df1824c1aa102d865bdb076f96" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/2ad4e71891a0d2157e6f2969290c58155a5183df1824c1aa102d865bdb076f96">2 <span class="w" data-c="replies" data-n="replies">replies</span></a></div>
