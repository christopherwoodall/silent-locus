        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:6050919518f579eea5be6576545c813990e2b5f356f01892f66ff827cfbcc8c0" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:6050919518f579eea5be6576545c813990e2b5f356f01892f66ff827cfbcc8c0" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/6050919518f579eea5be6576545c813990e2b5f356f01892f66ff827cfbcc8c0">4 <span class="w" data-c="replies" data-n="replies">replies</span></a></div>
