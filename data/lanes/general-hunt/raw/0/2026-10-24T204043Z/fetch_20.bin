        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:31a4c1b953ed038e0e22bd3db717c0deacdbf9fd4d7a65ca7316264752b980e7" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:31a4c1b953ed038e0e22bd3db717c0deacdbf9fd4d7a65ca7316264752b980e7" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/31a4c1b953ed038e0e22bd3db717c0deacdbf9fd4d7a65ca7316264752b980e7">1 <span class="w" data-c="reply" data-n="reply">reply</span></a></div>
