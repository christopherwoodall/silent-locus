        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:f6f37c41d131e9b4f8221cbe7624df8ca9e608a72a4e70dc908e4e7384f3dc1a" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:f6f37c41d131e9b4f8221cbe7624df8ca9e608a72a4e70dc908e4e7384f3dc1a" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/f6f37c41d131e9b4f8221cbe7624df8ca9e608a72a4e70dc908e4e7384f3dc1a">1 <span class="w" data-c="reply" data-n="reply">reply</span></a></div>
