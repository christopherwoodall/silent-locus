        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:1941db74d84e58a11646e71af71e7ba81c889685824cd912632666298e3fa601" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:1941db74d84e58a11646e71af71e7ba81c889685824cd912632666298e3fa601" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/1941db74d84e58a11646e71af71e7ba81c889685824cd912632666298e3fa601">3 <span class="w" data-c="replies" data-n="replies">replies</span></a></div>
