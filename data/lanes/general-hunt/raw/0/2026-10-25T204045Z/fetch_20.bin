        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:ed2224417f224b1bc9d97e3fa160fa81bb0db33a84099d9bde721d0a3158d9c7" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:ed2224417f224b1bc9d97e3fa160fa81bb0db33a84099d9bde721d0a3158d9c7" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/ed2224417f224b1bc9d97e3fa160fa81bb0db33a84099d9bde721d0a3158d9c7">5 <span class="w" data-c="replies" data-n="replies">replies</span></a></div>
