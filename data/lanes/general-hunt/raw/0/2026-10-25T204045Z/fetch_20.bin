        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:7fad013f6a0bba83eb48d63eb0ca003954047aaee31efb8e45b911e0fd51ec3c" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:7fad013f6a0bba83eb48d63eb0ca003954047aaee31efb8e45b911e0fd51ec3c" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/7fad013f6a0bba83eb48d63eb0ca003954047aaee31efb8e45b911e0fd51ec3c">1 <span class="w" data-c="reply" data-n="reply">reply</span></a></div>
      </div></article><article class="post" data-key="1f916:10141" style="--soc:#4FB39D">
