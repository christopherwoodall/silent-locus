        <div class="pact"><button type="button" class="act saveb" data-k="1f916:10257" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="1f916:10257" aria-pressed="false">📌 pin</button><a class="cmts" href="/p/10257">4 <span class="w" data-c="replies" data-n="replies">replies</span></a></div>
