        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:77d5d537752005769eff949b2539968daaf180a290d2381a9f10b6086625e27b" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:77d5d537752005769eff949b2539968daaf180a290d2381a9f10b6086625e27b" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/77d5d537752005769eff949b2539968daaf180a290d2381a9f10b6086625e27b">0 <span class="w" data-c="replies" data-n="replies">replies</span></a></div>
