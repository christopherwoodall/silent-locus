<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="A community wall for links, notes, photos and video.">
  <meta proof="proven.lol/2c6614">
  <link rel="icon" href="/favicon.ico">
  <link rel="me" href="https://mastodon.nervesocket.com/@ThaMunsta">
  <title>Latest posts | Social Wall | NerveSocket</title>
  <link rel="stylesheet" href="/assets/home.css">
  <link rel="stylesheet" href="/wall/assets/wall.css">  </head>
<body>
  <header class="top">
    <a class="brand" href="/">nervesocket<span>_</span></a>
    <nav>
              <a href="/">Home</a>
              <a href="/#projects">Projects</a>
              <a href="/wall/" aria-current="page">Wall</a>
              <a href="/about/">About</a>
            <a href="https://mastodon.nervesocket.com/">Mastodon</a>
      <a href="https://discord.gg/AJCTtKNzgn">Discord</a>
    </nav>
  </header>
    <main class="wall-main">
      <header class="wall-heading">
        <div><p class="eyebrow">NerveSocket / Social</p><h1><a href="/wall/">The Wall</a></h1></div>
        <nav class="wall-account">
                      <a href="/wall/login">Sign in</a><a class="btn btn-small" href="/wall/register">Join</a>
                  </nav>
      </header>
                    <section class="feed-discovery" aria-label="Discover posts">
            <form action="/wall/search" method="get" class="wall-search">
                <input type="search" name="q" maxlength="100" value="" placeholder="Search posts">
                <button class="btn btn-small">Search</button>
            </form>
            <a class="btn btn-small btn-shuffle" href="/wall/random" aria-label="Discover a random post" title="Random post">Shuffle</a>
        </section>
                        <form class="composer guest-composer" method="post" action="/wall/post">
            <input type="hidden" name="_csrf" value="ac2eadf58abc9054c7162427690bb0ec4fa53803fdf41ba85acc7ed360d8be87">            <div class="composer-label"><strong>Leave a note</strong><span>Guest posts are text-only.</span></div>
            <label class="guest-name">Name <span>(optional)</span><input type="text" name="guest_name" maxlength="80" placeholder="Guest"></label>
            <textarea name="body" maxlength="5000" rows="4" placeholder="A thought, a link, something worth sharing..." required></textarea>
            <div class="composer-tools"><button class="btn" type="submit">Post as guest</button><a href="/wall/login">Sign in for media, likes and comments</a></div>
            <div class="hp" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
        </form>
                <div class="feed-toolbar"><h2>Latest posts</h2><span>0 shown</span></div>
                <section class="feed" aria-label="Latest posts">
                        <div class="wall-empty"><h3>No matching posts.</h3><p>Try another search or browse the latest posts.</p><a href="/wall/">Latest posts</a></div>        </section>
                      <footer class="wall-footer"><a href="/">NerveSocket</a><span>Posts are public. Be kind, keep it useful.</span></footer>
    </main>
    <script src="/wall/assets/wall.js" defer></script>
      <footer class="bottom">
    <p>&copy; 2026 NerveSocket &middot; <a href="https://ko-fi.com/thamunsta">Leave a tip</a></p>
  </footer>
</body>
</html>
