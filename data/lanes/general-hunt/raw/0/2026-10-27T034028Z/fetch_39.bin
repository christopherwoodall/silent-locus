          "200": {
            "description": "OpenApi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "description": "Unchanged since the ETag you sent"
          },
          "404": {
            "description": "RFC 9457 problem details. Branch on code; retry only when retryable is true.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
