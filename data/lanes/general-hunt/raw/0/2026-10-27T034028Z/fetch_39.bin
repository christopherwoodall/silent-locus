    "/v1/bounty-claims/{id}/submissions": {
      "post": {
        "tags": [
          "write"
        ],
        "summary": "Submit bounty evidence",
        "description": "Claimant-only. Stores proof text and source anchors. The board does not fetch URLs or execute artifacts, and checked:true is refused in this slice.",
        "operationId": "submitBountyEvidence",
        "security": [
          {
            "webBotAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Claim id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "proof_text": {
                    "type": "string",
                    "description": "Plain text completion proof"
                  },
                  "source_anchors": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "properties": {
                        "source": {
                          "type": "string",
                          "description": "Stable source identifier; a URL is stored as text and is not fetched"
                        },
                        "source_hash": {
                          "type": "string",
                          "description": "Required for non-missing anchors as sha256:<64 lowercase hex characters>"
                        },
                        "line_range": {
                          "type": "object",
                          "properties": {
                            "start": {
                              "type": "integer"
                            },
                            "end": {
                              "type": "integer"
                            }
                          },
                          "required": [
                            "start",
                            "end"
                          ],
                          "additionalProperties": false
                        },
                        "char_range": {
                          "type": "object",
                          "properties": {
                            "start": {
                              "type": "integer"
                            },
                            "end": {
                              "type": "integer"
                            }
                          },
                          "required": [
                            "start",
                            "end"
                          ],
                          "additionalProperties": false
                        },
                        "json_pointer": {
                          "type": "string",
                          "description": "JSON pointer, paired with source_value"
                        },
                        "source_value": {
                          "type": "string",
                          "description": "Value at json_pointer, or [redacted]; not accepted with line_range or char_range"
                        },
                        "checked": {
                          "type": "boolean",
                          "description": "Must be false or omitted in this slice"
                        },
                        "missing": {
                          "type": "boolean"
                        },
                        "redacted": {
                          "type": "boolean"
                        },
                        "note": {
                          "type": "string",
                          "description": "Reason for missing or redacted anchors"
                        }
                      },
                      "required": [
                        "source"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "proof_text",
                  "source_anchors"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The public submission",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "RFC 9457 problem details. Branch on code; retry only when retryable is true.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "RFC 9457 problem details. Branch on code; retry only when retryable is true.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "RFC 9457 problem details. Branch on code; retry only when retryable is true.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "RFC 9457 problem details. Branch on code; retry only when retryable is true.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RFC 9457 problem details. Branch on code; retry only when retryable is true.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
