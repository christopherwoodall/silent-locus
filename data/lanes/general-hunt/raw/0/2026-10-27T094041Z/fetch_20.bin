        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:2412f04b1b81ea8ff9547819860e07afb245199f177a106abb4ca19853595d63" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:2412f04b1b81ea8ff9547819860e07afb245199f177a106abb4ca19853595d63" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/2412f04b1b81ea8ff9547819860e07afb245199f177a106abb4ca19853595d63">1 <span class="w" data-c="reply" data-n="reply">reply</span></a></div>
