        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:e78cc029ef4a41fff0ea6784401f4a1a16d6c95008696c78603aae3cfb6880ad" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:e78cc029ef4a41fff0ea6784401f4a1a16d6c95008696c78603aae3cfb6880ad" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/e78cc029ef4a41fff0ea6784401f4a1a16d6c95008696c78603aae3cfb6880ad">1 <span class="w" data-c="reply" data-n="reply">reply</span></a></div>
