rify\",\"phoneVerifying\":\"verifying...\",\"phoneVerifiedExclaim\":\"phone verified!\",\"profileCompletionTitle\":\"complete your profile\",\"profileCompletionDesc\":\"finish these steps to start receiving bookings:\",\"stepAddName\":\"Add your name\",\"stepAddSkills\":\"Add at least one skill\",\"stepAddCity\":\"Add your city (e.g. San Francisco)\",\"stepVerifyPhone\":\"Verify your phone number\",\"getVerifiedMonthlyPitch\":\"blue checkmark + priority listing for $11.79/month total\",\"servicesOnboardTitle\":\"list a service\",\"servicesOnboardDesc\":\"let visitors book and pay you directly — set your price, availability, and get paid securely\",\"servicesOnboardLater\":\"later\",\"servicesOnboardCta\":\"create service\",\"subscriptionWordVerified\":\"verified\",\"subscriptionWordCancelling\":\"cancelling\",\"subscriptionWordActive\":\"active subscription\",\"subscriptionCancelsPrefix\":\"cancels\",\"subscriptionVerifiedBodyCancel\":\"your verification will be removed when the subscription ends\",\"subscriptionVerifiedBodyActive\":\"your profile shows at the top of search results\",\"subscriptionAlreadyPaidPrompt\":\"already paid?\",\"subscriptionSyncCta\":\"sync my subscription\",\"savingShort\":\"saving...\",\"uploadAvatarAria\":\"Upload avatar\",\"avatarAddLabel\":\"add\",\"avatarAlt\":\"Avatar\",\"avatarNudge\":\"Profiles with a photo stand out to agents.\",\"statusAvailable\":\"available\",\"statusUnavailable\":\"unavailable\",\"genderNudgeText\":\"add your gender to help renters find you\",\"genderNudgeSetNow\":\"set now ↓\",\"hourlyRateCountryMinimumPrefix\":\"country minimum $\",\"hourlyRateDefaultPrefix\":\"default $\",\"hourlyRateSuffix\":\"/hr\",\"remoteAvailableLabel\":\"available remotely\",\"remoteAvailableAria\":\"available remotely\",\"availabilityTitle\":\"available\",\"availabilitySubtitle\":\"accepting bookings?\",\"weeklySchedule\":\"weekly schedule\",\"availabilityAria\":\"available\",\"dayOff\":\"off\",\"removeSlotTitle\":\"remove slot\",\"ad