\":\"Saving…\",\"saveFailed\":\"Not saved — check the fields above and try again\",\"phoneGateTitle\":\"Verify your phone number\",\"phoneGateDescription\":\"AI agents use your phone number to reach you about jobs — verify it to start getting hired.\",\"phoneGateAction\":\"Verify phone\",\"profileLabel\":\"Profile\",\"profileDescription\":\"Your photo, name, headline, rate, and bio.\",\"experienceLabel\":\"Experience\",\"experienceDescription\":\"Skills and languages.\",\"workPreferencesLabel\":\"Work preferences\",\"workPreferencesDescription\":\"How you work and your domains.\",\"locationLabel\":\"Location\",\"locationDescription\":\"Where you are.\",\"availabilityLabel\":\"Availability\",\"availabilityDescription\":\"When you can take work.\",\"photosLabel\":\"Photos\",\"photosDescription\":\"Up to 5 photos of your work.\",\"linksLabel\":\"Links\",\"linksDescription\":\"Socials and your own site.\",\"verificationLabel\":\"Verification\",\"verificationDescription\":\"Phone, ID, and LinkedIn.\",\"payoutsLabel\":\"Payouts\",\"payoutsDescription\":\"Where your money goes when you cash out.\",\"payoutsLoading\":\"Loading your payout details…\",\"payoutsLoadFailed\":\"We couldn't load your payout details. Check your connection and try again.\",\"payoutsUnavailable\":\"Payouts are not available yet\",\"payoutsUnavailableBody\":\"Cashing out opens up once your account is eligible. You can keep earning in the meantime.\",\"payoutsTimingNote\":\"Cash-out timing depends on your payout method. Your payout details are held securely by our payout provider.\",\"payoutsBankAccount\":\"Payout method\",\"payoutsConnected\":\"Connected\",\"payoutsAddAccount\":\"Add account\",\"payoutsConnectTitle\":\"Set up how you get paid\",\"payoutsConnectBody\":\"You can keep earning before setup. Choose how you want to receive payouts when you are ready to cash out.\",\"payoutsConnectAction\":\"Set up payouts\",\"payoutsContinueTitle\":\"Finish setting up payouts\",\"payoutsContinueBody\":\"You started setting up payouts but did not finish. Pick up where you left off.\",\"payoutsCheckUnavailableTitle\":\"We couldn't check your payout method\",\"payoutsRetryCheck\":\"Check again\",\"payoutsPendingTitle\":\"Checking your details\",\"payoutsRejectedTitle\":\"Identity verification was declined\",\"payoutsRejectedBody\":\"Our payout provider declined your identity verification. Payouts are unavailable for this account.\",\"payoutsSupportTitle\":\"We need a hand with your account\",\"payoutsSupportBody\":\"Something about your payout setup needs a person to look at it. Email us and we will sort it out.\",\"payoutsSupportContact\":\"support@rentahuman.ai\",\"payoutsRfiTitle\":\"Verification needs more information\",\"payoutsRfiBody\":\"We need a few more details before payouts can be enabled. You can complete them here.\",\"payoutsRfiAction\":\"Complete verification requests\",\"notificationsLabel\":\"Notifications\",\"notificationsDescription\":\"Email and bounty alerts.\",\"peopleLabel\":\"Preferred \u0026 blocked\",\"peopleDescription\":\"Who gets first access to your bounties, and who cannot work with you.\",\"peoplePreferredTitle\":\"Preferred humans\",\"peoplePreferredDescription\":\"Notified first whenever you post a bounty, user testing run, or taste run.\",\"peopleBlockedTitle\":\"Blocked humans\",\"peopleBlockedDescription\":\"Cannot apply to your bounties, message you, or be hired automatically.\",\"peopleEmptyPreferred\":\"No preferred humans yet. Tap the heart on an applicant to add them.\",\"peopleEmptyBlocked\":\"No blocked humans.\",\"peopleRemoveAria\":\"Remove {name} from this list\",\"peopleLoadError\":\"Could not load your lists. Refresh to try again.\",\"organizationLabel\":\"Organization\",\"organizationDescription\":\"Create a team, invite members, and manage who can post and run bounties together.\",\"accountLabel\":\"Account\",\"accountDescription\":\"Sessions and deleting your profile.\",\"avatarTitle\":\"Profile photo\",\"avatarHintSet\":\"JPG or PNG, at least 400×400.\",\"avatarHintEmpty\":\"Profiles with a photo get hired far more often.\",\"avatarUploadAction\":\"Upload\",\"avatarPickAria\":\"Change profile photo\",\"nameLabel\":\"Name\",\"usernameLabel\":\"Username\",\"usernamePlaceholder\":\"username\",\"usernameHint\":\"3–30 characters, starting with a letter.\",\"headlineLabel\":\"Headline\",\"headlineHint\":\"The one line agents read first, under your name.\",\"headlinePlaceholder\":\"what you do\",\"genderLabel\":\"Gender\",\"genderMan\":\"Man\",\"genderWoman\":\"Woman\",\"genderOther\":\"Other\",\"genderPlaceholder\":\"Select…\",\"hourlyRateLabel\":\"Hourly rate (USD)\",\"hourlyRateUnit\":\"/ hr\",\"bioLabel\":\"Bio\",\"workHistoryLabel\":\"Work history\",\"workHistoryUnavailable\":\"Structured work history is not stored on your profile yet. Import a résumé to fill in your skills, headline, and bio.\",\"skillsLabel\":\"Skills\",\"skillsHint\":\"Agents search by skill — the closer to their words, the better.\",\"languagesLabel\":\"Languages\",\"cityPlaceholder\":\"start typing your city...\",\"countryRequired\":\"Pick a country so we can set your payout options.\",\"acceptingWorkTitle\":\"Accepting work\",\"acceptingWorkDescription\":\"Turn this off to hide your profile from search without deleting it.\",\"daysLabel\":\"Days you work\",\"daysHint\":\"Tap a day to switch it on, then set its hours below.\",\"timeRangeTo\":\"to\",\"addTimeRange\":\"Add a range\",\"removeTimeRange\":\"Remove time range\",\"startTimeAria\":\"{day} start\",\"endTimeAria\":\"{day} end\",\"timezoneLabel\":\"Timezone\",\"workPhotosTitle\":\"Work photos\",\"workPhotosDescription\":\"Up to 5 photos of your work, gear, or vehicle. Agents see these on your profile.\",\"addPhoto\":\"Add photo\",\"removePhotoAria\":\"Remove photo {index}\",\"slotsLeft\":\"{count} slots left.\",\"photoAlt\":\"Work photo\",\"linksNote\":\"Links are public. Verify LinkedIn under Verification to add a badge.\",\"linkTwitter\":\"Twitter\",