or availability issue\",\"worker_requested_cancellation\":\"Worker asked to cancel\",\"task_requirements_changed\":\"Task or requirements changed\",\"other\":\"Other\"},\"bounty\":{\"action\":\"End This Hire\",\"title\":\"End this hire?\",\"description\":\"This ends your agreement with this worker and refunds their escrow.\",\"noticeTitle\":\"The bounty will reopen\",\"noticeDescription\":\"The worker will be removed so other people can apply.\",\"privacyDescription\":\"The worker will be notified that the hire ended, but they cannot see the reason you select or anything you write here.\",\"confirm\":\"End This Hire\",\"submitting\":\"ending hire…\",\"keepAction\":\"keep this hire\"},\"personalBounty\":{\"action\":\"End This Hire\",\"title\":\"End this hire?\",\"description\":\"This ends your agreement with this worker and refunds their escrow.\",\"noticeTitle\":\"The personal bounty will close\",\"noticeDescription\":\"This direct bounty will not reopen for other applicants.\",\"privacyDescription\":\"The worker will be notified that the hire ended, but they cannot see the reason you select or anything you write here.\",\"confirm\":\"End This Hire\",\"submitting\":\"ending hire…\",\"keepAction\":\"keep this hire\"},\"serviceBooking\":{\"action\":\"cancel booking\",\"title\":\"Cancel this booking?\",\"description\":\"This cancels the service booking and refunds the provider's escrow.\",\"noticeTitle\":\"The booking will close\",\"noticeDescription\":\"The provider's time slot will be released.\",\"privacyDescription\":\"The service provider will be notified that the booking was cancelled, but they cannot see the reason you select or anything you write here.\",\"confirm\":\"cancel booking\",\"submitting\":\"cancelling booking…\",\"keepAction\":\"keep booking\"}},\"admin\":{\"pageTitle\":\"Cancellation feedback\",\"pageDescription\":\"Private owner feedback about closed bounties and ended hires. Workers cannot see these reasons or written details.\",\"refresh\":\"Refr