cription\":\"Removes your profile, messages, and history. Paid-out earnings stay in your records. This cannot be undone.\",\"deleteProfileAction\":\"Delete profile\"},\"organizations\":{\"inviteTitle\":\"Join {org}\",\"inviteSubtitle\":\"{inviter} invited you to join {org} on RentAHuman.\",\"inviteRoleAdmin\":\"You'll join as an admin.\",\"inviteRoleMember\":\"You'll join as a member.\",\"inviteSentTo\":\"Invitation sent to {email}\",\"inviteSignedInAs\":\"Signed in as {email}\",\"inviteAccept\":\"Accept invitation\",\"inviteAccepting\":\"Joining…\",\"inviteJoined\":\"Welcome to {org}!\",\"inviteJoinedHint\":\"Taking you to your organization settings…\",\"inviteInvalidTitle\":\"Invitation unavailable\",\"inviteInvalidBody\":\"This invitation link is invalid or was removed.\",\"inviteExpiredBody\":\"This invitation has expired. Ask your organization admin to send a new one.\",\"inviteRevokedBody\":\"This invitation was revoked. Ask your organization admin to send a new one.\",\"inviteUsedBody\":\"This invitation has already been used.\",\"inviteEmailMismatchBody\":\"This invitation was sent to {email}, but you are signed in as {current}. Sign in with the invited email or ask for a new invitation.\",\"inviteAlreadyInOrgBody\":\"You already belong to an organization. Leave it before joining another one.\",\"inviteOrgFullBody\":\"This organization has reached its member limit. Ask the owner to free a seat.\",\"inviteErrorGeneric\":\"Something went wrong. Please try again.\",\"loadError\":\"Could not load your organization. Refresh to try again.\",\"genericError\":\"Something went wrong. Please try again.\",\"createTitle\":\"Create an organization\",\"createDescription\":\"Work as a team: members post bounties as the organization and manage them together.\",\"createNamePlaceholder\":\"Organization name\",\"createAction\":\"Create organization\",\"createdNotice\":\"Organization created.\",\"yourRole\":\"Your role: {role}\",\"renameAria\":\"Organization name\",\"renameAction\":\"Rename\",\"renamedNotice\":\"Organization renamed.\",\"membersTitle\":\"Members\",\"membersDescription\":\"Everyone here can see and manage the organization’s bounties.\",\"roleOwner\":\"Owner\",\"roleAdmin\":\"Admin\",\"roleMember\":\"Member\",\"roleChangedNotice\":\"Role updated.\",\"roleSelectAria\":\"Change role for {name}\",\"removeMemberAria\":\"Remove {name} from the organization\",\"memberRemovedNotice\":\"Member removed.\",\"inviteTitle2\":\"Invite by email\",\"inviteDescription\":\"They’ll get an email with a link to sign up and join your organization.\",\"inviteEmailPlaceholder\":\"teammate@company.com\",\"inviteRoleAria\":\"Role for the invited member\",\"inviteAction\":\"Send invite\",\"inviteSentNotice\":\"Invite sent.\",\"inviteResendAction\":\"Resend\",\"inviteResentNotice\":\"Invite resent with a fresh link.\",\"inviteRevokeAria\":\"Revoke the invite for {email}\",\"inviteRevokedNotice\":\"Invite revoked.\",\"leaveTitle\":\"Leave organization\",\"leaveDescription\":\"You will lose access to the organization’s bounties. Bounties you created stay yours.\",\"leaveConfirm\":\"Leave this organization?\",\"leaveAction\":\"Leave organization\",\"leftNotice\":\"You left the organization.\"},\"qa\":{\"rentaChatTitle\":\"Plan a user testing run with Renta\",\"rentaChatDescription\":\"Describe the journey in plain language. Renta will gather the details and prefill the template for review.\",\"rentaChatIntro\":\"Hi! I'm Renta 👋 Tell me what you want tested and I'll help you set up the user testing run.\",\"rentaChatPlaceholder\":\"Describe what you want tested. For example: \\\"Test checkout on mystore.com weekly with 3 testers at $10 each\\\"\",\"rentaChatSignedOutPlaceholder\":\"Sign in to plan a user testing run with Renta...\",\"rentaChatAuthRequired\":\"You need to be signed in to create user testing runs. Please sign in and try again!\",\"rentaChatError\":\"Something went wrong. Please try again.\",\"manualSetup\":\"Set up manually\",\"newRunChooserTitle\":\"What do you want to run?\",\"newRunChooserQaTitle\":\"User testing run\",\"newRunChooserQaDescription\":\"Real people test your app or website and report bugs with video evidence.\",\"newRunChooserTasteTitle\":\"Design vote\",\"newRunChooserTasteDescription\":\"Real people vote between designs, screenshots, or copy and tell you why.\",\"newRunChooserBountyTitle\":\"General bounty\",\"newRunChooserBountyDescription\":\"Post any real-world task and hire humans to get it done.\",\"newRunChooserBack\":\"All run types\",\"newRunTemplatesTitle\":\"Or start from a ready-made bounty template:\",\"heroEyebrow\":\"Human user testing, on repeat\",\"heroDescription\":\"Set the journey once. Qualified humans run it on schedule and return evidence-backed findings you can act on.\",\"heroCta\":\"Set up a user testing run\",\"heroProof\":\"You approve the audience, evidence, and spending limit.\",\"heroOutcome\":\"A recurring stream of real-world product feedback, not another synthetic test.\",\"howTitle\":\"From critical journey to clear findings\",\"howDescription\":\"You define the test once. Rent A Human handles matching, evidence, and repeat runs.\",\"howDefineTitle\":\"Define the journey\",\"howDefineDescription\":\"Tell testers what to do, where to do it, and what counts as a problem.\",\"howMatchTitle\":\"Choose who tests\",\"howMatchDescription\":\"Require the right experience, device, language, or country when it matters.\",\"howReportTitle\":\"Get evidence, not guesses\",\"howReportDescription\":\"Review findings with repro steps and proof from each completed run.\",\"apiAccessEyebrow\":\"API access\",\"apiAccessTitle\":\"Run the same user testing program from your agent.\",\"apiAccessDescription\":\"Create schedules, monitor autonomous runs, and read reports with an account API key.\",\"apiAccessDocsCta\":\"Read the user testing API docs\",\"apiAccessSkillCta\":\"Download the agent skill\",\"apiAccessKeysCta\":\"Manage API keys\",\"tabCreate\":\"Create new\",\"tabTemplates\":\"Schedules\",\"tabRuns\":\"Active jobs\",\"tabIntegrations\":\"Integrations\",\"tabPreferred\":\"Preferred workers\",\"preferredTitle\":\"Preferred \u0026 blocked workers\",\"preferredDescription\":\"Preferred workers are notified first whenever you post a bounty, user testing run, or taste run. Blocked workers cannot apply, message you, or be hired automatically.\",\"integrationsTitle\":\"Connect your user testing workflow\",\"integrationsDescription\":\"Give your agents and product tools a direct path to create user testing runs, monitor progress, and read reports.\",\"integrationsMcpTitle\":\"MCP server\",\"integrationsMcpDescription\":\"Connect compatible agents to RentAHuman tools for creating and monitoring user testing runs.\",\"integrationsMcpCta\":\"Read the MCP docs\",\"integrationsSkillTitle\":\"User testing agent skill\",\"integrationsSkillDescription\":\"Give your agent a ready-made workflow for planning, funding, and reviewing human user testing.\",\"linearTitle\":\"Run human user testing from Linear\",\"linearDescription\":\"Install the RentAHuman agent, set a per-run budget, and mention @RentAHuman on any issue to start a one-time human user testing run.\",\"linearInstall\":\"Install Linear app\",\"linearWorkspace\":\"Linear workspace\",\"linearEnabled\":\"Allow @RentAHuman to start paid runs\",\"linearMentionHelp\":\"Mention @RentAHuman in an issue comment. Include a URL to override the default target for that run.\",\"linearBudget\":\"Maximum charge per mention\",\"linearSave\":\"Save settings\",\"linearSaving\":\"Saving…\",\"linearSaved\":\"Settings saved\",\"linearDisconnect\":\"Disconnect\",\"linearEmpty\":\"No Linear workspace is connected yet.\",\"linearError\":\"Could not update the Linear integration. Try again.\",\"title\":\"Pay real people to test your app.\",\"subtitle\":\"Run recurring human user testing on your app or website, scheduled automatically and paid from your wallet.\",\"walletBalanceLabel\":\"Balance\",\"walletLowBalanceShort\":\"Add funds before the next active run.\",\"walletError\":\"Could not load your wallet balance.\",\"schedulesTitle\":\"User testing schedules\",\"schedulesDescription\":\"The product journeys your testers run on repeat.\",\"newSchedule\":\"New schedule\",\"templatesEmptyTitle\":\"Start with one critical product journey\",\"templatesEmptyDescription\":\"Choose a flow your customers depend on and get evidence from real people.\",\"pause\":\"Pause\",\"resume\":\"Resume\",\"deleteSchedule\":\"Delete\",\"deleteScheduleTitle\":\"Delete this schedule?\",\"deleteScheduleDescription\":\"This removes the schedule from your list. Existing and completed runs, reports, and payment history are kept.\",\"deleteScheduleConfirm\":\"Delete schedule\",\"deleteScheduleDeleting\":\"Deleting…\",\"deleteScheduleUnavailableTitle\":\"Delete unavailable\",\"deleteScheduleUnavailableDescription\":\"Pause this schedule before deleting it. Any run already in progress will continue and remain in your history.\",\"statusActive\":\"active\",\"statusPaused\":\"paused\",\"statusComplete\":\"complete\",\"statusRunCreated\":\"run created\",\"statusRunInProgress\":\"run in progress\",\"statusRunNeedsAttention\":\"needs attention\",\"statusRunIncomplete\":\"incomplete\",\"pausedReasonUser\":\"Paused by you\",\"pausedReasonFailures\":\"Paused after repeated failures\",\"pausedReasonFunds\":\"Paused for insufficient funds\",\"pausedReasonOneTime\":\"One-time run created\",\"cadenceOnce\":\"Just once\",\"cadenceDaily\":\"Daily\",\"cadenceEvery2Days\":\"Every 2 days\",\"cadenceWeekly\":\"Weekly\",\"cadenceCustom\":\"Custom\",\"cadenceCustomDays\":\"Every {days} days\",\"submissionPhoto\":\"Photo\",\"submissionVideo\":\"Video\",\"submissionDocument\":\"Document\",\"perRun\":\"/run\",\"perTester\":\"/tester\",\"testersLabel\":\"testers\",\"nextRun\":\"Next run\",\"formCreateTitle\":\"Set up your user testing run\",\"formEditTitle\":\"Edit your user testing run\",\"formIntro\":\"Define the journey, choose the right testers, and set the pay.\",\"formTestTitle\":\"What should people test?\",\"formTestDescription\":\"Give testers one clear journey and explain what useful evidence looks like.\",\"formAudienceTitle\":\"Who should test?\",\"formAudienceDescription\":\"Target only when it improves the result. Leave both fields open for the largest tester pool.\",\"formName\":\"Name\",\"formNamePlaceholder\":\"Checkout flow smoke test\",\"formTargetUrl\":\"Target URL\",\"websiteAccessDraft\":\"Draft — website access needs attention\",\"websiteAccessRetry\":\"Retry and launch\",\"websiteAccessScope\":\"We check basic website reachability before launch, not whether every test step works.\",\"websiteAccessReasons\":{\"responded\":\"The website responded.\",\"unsafe_url\":\"Use a public HTTP or HTTPS website URL without embedded credentials. Private and local addresses cannot be tested.\",\"dns_not_found\":\"The website domain could not be found. Check the URL spelling and DNS setup, then retry.\",\"connection_failed\":\"A connection to the website could not be established. Check that the website is online, then retry.\",\"http_error\":\"The website returned an error response. Correct the URL or restore the page, then retry.\",\"empty_response\":\"The website returned no page. Check the target URL, then retry.\",\"redirect_error\":\"The website redirects could not reach a page. Check the URL and redirects, then retry.\",\"access_restricted\":\"The check is inconclusive: sign-in, bot protection, or a temporary restriction may prevent automated access. Verify that testers can open the website.\",\"timeout\":\"The access check timed out. This does not confirm a broken website. Verify that testers can open it, or retry.\",\"check_unavailable\":\"The access check was inconclusive. Verify that testers can open the website, or retry.\"},\"formInstructions\":\"Instructions for testers\",\"formInstructionsPlaceholder\":\"What should testers do, and what counts as a finding?\",\"formMediaLabel\":\"Reference images \u0026 videos\",\"formMediaDescription\":\"Optional. Show testers exactly what to look at — screenshots of the screens involved, or a short walkthrough video.\",\"formMediaAdd\":\"Add image or video\",\"formMediaUploading\":\"Uploading…\",\"formMediaUploadError\":\"Upload failed. Please try again.\",\"formMediaFileTypes\":\"JPG, PNG, WebP, GIF, MP4, MOV, or WebM\",\"formMediaCaptionLabel\":\"Caption\",\"formMediaCaptionPlaceholder\":\"Add a caption (optional)\",\"formMediaRemove\":\"Remove media\",\"formChecklistTitle\":\"Required test items\",\"formChecklistDescription\":\"Break the test into specific items testers must complete. Each item can carry its own instructions and reference media — testers see them as a checklist, and the AI reviewer checks every item against the submitted evidence.\",\"formChecklistEmpty\":\"No required test items yet. Add one to give testers a concrete checklist.\",\"formChecklistAddItem\":\"Add test item\",\"formChecklistRemoveItem\":\"Remove test item\",\"formChecklistMoveItemUp\":\"Move test item up\",\"formChecklistMoveItemDown\":\"Move test item down\",\"formChecklistItemTitleLabel\":\"Item title\",\"formChecklistItemTitlePlaceholder\":\"e.g. Complete checkout with a saved card\",\"formChecklistItemInstructionsLabel\":\"Item instructions\",\"formChecklistItemInstructionsPlaceholder\":\"What exactly should the tester do and verify for this item? (optional)\",\"formErrorChecklistTitle\":\"Each required test item needs a title between 3 and 120 characters.\",\"formErrorChecklistCount\":\"You can add up to 30 required test items.\",\"formErrorMediaCount\":\"You can attach up to 6 images or videos to the instructions.\",\"checklistResultsTitle\":\"Required test items\",\"checklistStatusDone\":\"Done\",\"checklistStatusNotDone\":\"Not done\",\"checklistStatusUnclear\":\"Unclear\",\"previousQaJobs\":\"{count} previous user testing jobs\",\"formTesterStartMessage\":\"Private start message\",\"formTesterStartMessageDescription\":\"Optional. Sent privately to every tester after they are accepted.\",\"formTesterStartMessagePlaceholder\":\"Test account: qa-user@example.com\\nPassword: ...\\nUse the sandbox workspace named Checkout Testing.\",\"formTesterStartMessageSecurity\":\"Use test-only credentials. Never share personal, admin, production, financial, or recovery credentials.\",\"formRequiredCredentials\":\"Skills and requirements\",\"formRequiredCredentialsPlaceholder\":\"e.g. Owns an iPhone 15 or newer\",\"formRequirementInputLabel\":\"Tester skill or requirement\",\"formAddRequirement\":\"Add requirement\",\"formRequirementMinCharacters\":\"3 characters minimum\",\"formRemoveRequirement\":\"Remove requirement\",\"formNoRequirements\":\"No special requirements. Any qualified tester can apply.\",\"formAutoModeTesterNoun\":\"tester\",\"formAutoModeRespondentNoun\":\"respondent\",\"formAutoModeTitle\":\"Auto mode\",\"formAutoModeOn\":\"On\",\"formAutoModeOff\":\"Off\",\"formAutoModeOnDescription\":\"Renta hires and evaluates every {noun} for you. It removes anyone who does a bad job and pays out automatically when a submission is good.\",\"formAutoModeOffDescription\":\"You approve every {noun} and every payout yourself. Renta still reviews the work and shows you what it would have done.\",\"formAllowedCountries\":\"Tester countries\",\"formAllowedCountriesDescription\":\"Optional. Selected countries are enforced when testers apply.\",\"formChooseCountries\":\"Choose tester countries\",\"formAnywhere\":\"Anywhere\",\"formCountriesSelected\":\"countries selected\",\"formCountrySearch\":\"Search countries...\",\"formCountryEmpty\":\"No country found.\",\"formRemoveCountry\":\"Remove\",\"formScheduleTitle\":\"Schedule, evidence, and pay\",\"formScheduleDescription\":\"Choose how often the test runs, what proof you need, and what each tester earns.\",\"formCadence\":\"Cadence\",\"formCadenceDays\":\"Repeat every\",\"formCadenceDaysDescription\":\"Enter a whole number from 1 to 30 days.\",\"formSubmissionMode\":\"Evidence type\",\"formVideoEvidenceHelper\":\"Video submissions require a full screen recording plus one representative screenshot. Narration of actions, errors, and improvement ideas is strongly encouraged but optional. Use MP4, MOV, or WebM up to 512 MB.\",\"formTesterCount\":\"Testers per run\",\"formPayPerTester\":\"Pay per tester (USD)\",\"formEstimateTitle\":\"Cost per run\",\"platformFee\":\"Service fee\",\"total\":\"Total\",\"formCreate\":\"Start run\",\"formApplicantScreening\":\"Application screening\",\"formApplicantScreeningDescription\":\"Choose what applicants must provide before they can be selected. The reviewer checks these materials against your tester requirements.\",\"formScreeningVideo\":\"Require a live camera introduction\",\"formScreeningLinkedin\":\"Require a LinkedIn profile\",\"formScreeningResume\":\"Require a resume upload (PDF, DOCX, or TXT)\",\"formCreating\":\"Creating schedule...\",\"formSaving\":\"Saving changes...\",\"formErrorRequired\":\"Name, target URL, and instructions are required.\",\"formErrorUrl\":\"Target URL must be a valid http(s) URL.\",\"formErrorTesterStartMessageLength\":\"The private start message must be 1,500 characters or fewer.\",\"formErrorAmounts\":\"Amounts must be positive and tester count a whole number of at least 1.\",\"formErrorCadenceDays\":\"Custom cadence must be a whole number from 1 to 30 days.\",\"formErrorCredentialsCount\":\"Tester credentials can include up to 10 lines.\",\"formErrorCredentialLength\":\"Each tester credential must be 3-200 characters.\",\"formErrorCountriesCount\":\"Allowed countries can include up to 30 codes.\",\"formErrorGeneric\":\"Something went wrong. Please try again.\",\"formWalletLowBalanceWarning\":\"Test created, but your wallet balance ({balance}) is below this run’s budget ({required}). Add funds to your wallet so testers can be paid when it starts.\",\"restrictionCountriesLabel\":\"Countries\",\"restrictionCredentialLabel\":\"Requirement\",\"restrictionCredentialsLabel\":\"requirements\",\"runsTitle\":\"Active jobs\",\"runsDescription\":\"User testing runs and taste votes reserve budget, hire real people, and produce a report.\",\"runsEmptyTitle\":\"No runs yet\",\"runsEmptyDescription\":\"Runs appear here once a user testing schedule or taste run starts.\",\"runsEmptyCta\":\"Start a new run\",\"runsFilterAll\":\"All templates\",\"runsFilterLabel\":\"Filter by template\",\"jobTypeFilterAll\":\"All job types\",\"jobTypeFilterLabel\":\"Filter by job type\",\"runOrderDetails\":\"Order details\",\"scheduledFor\":\"Scheduled\",\"reserved\":\"Reserved\",\"spent\":\"Spent\",\"refunded\":\"Refunded\",\"reviewApplicantsAction\":\"Review applicants\",\"seatsFilledSummary\":\"{filled} of {total} seats filled\",\"runFullNotice\":\"Every seat on this run is filled. {count} screened applicants are waiting and are seated automatically if a seat reopens.\",\"runFullNextStep\":\"To test with more people, raise the tester count on this test for its next run, or start a new run.\",\"runFullEditLink\":\"Edit tester count\",\"hireTesterAddSeatAction\":\"Add a seat and hire\",\"hireTesterAddSeatTitle\":\"Add a paid seat for {name}?\",\"hireTesterAddSeatDescription\":\"This run is full. One more seat costs {charge} ({pay} tester pay + {fee} fee), charged to your wallet now. Wallet balance: {balance}.\",\"hireTesterAddSeatReserved\":\"The seat is reserved for {name}: automatic seating cannot give it to anyone else, and if {name} does not take it the seat is refunded to your wallet. Your schedule's tester count for future runs does not change.\",\"hireTesterAddSeatConfirm\":\"Pay {charge} and hire\",\"hireTesterAddSeatShortfall\":\"Your wallet balance is {balance}. Add {shortfall} more to cover this seat.\",\"hireTesterAddSeatSuccess\":\"{name} is hired and has been notified. {charge} was charged to your wallet.\",\"runFullHireHint\":\"To hire a specific screened applicant right away, add a paid seat for them from their row below ({charge} per seat).\",\"hireTesterAddFunds\":\"Add funds\",\"hireTesterOfferSentSuccess\":\"{name} has been offered the seat and has {hours} hours to confirm. If they do not, the seat is refunded to your wallet.\",\"hireTesterAction\":\"Hire now\",\"hireTesterTitle\":\"Hire {name} for this run?\",\"hireTesterDescription\":\"Their seat is paid from this run’s prepaid pool ({pay} per tester). Nothing extra is charged. They receive the instructions right away and the usual completion window.\",\"hireTesterConfirm\":\"Hire tester\",\"hireTesterHiring\":\"Hiring…\",\"hireTesterSuccess\":\"{name} is hired and has been notified.\",\"hireTesterError\":\"Could not hire this tester.\",\"applicantWaitingForSeat\":\"Screened · waiting for a seat\",\"applicantWaitingRunFull\":\"Screened · run is full\",\"testerFilterLabel\":\"Filter testers by status\",\"testerFilterAll\":\"All testers\",\"testerFilterApproved\":\"Approved\",\"testerFilterScreening\":\"Screening in progress\",\"testerFilterNotSelected\":\"Not selected\",\"testerFilterEmpty\":\"No testers match this filter.\",\"testerFilterShowAll\":\"Show all testers\",\"viewSubmissionAction\":\"View submission\",\"hideSubmissionAction\":\"Hide submission\",\"applicationStatusAwaitingRevision\":\"Revision requested · awaiting resubmission\",\"ownerReviewAvailable\":\"Our team has not completed its review. You can review the submitted evidence and decide now.\",\"ownerReviewApprove\":\"Approve result\",\"ownerReviewRevise\":\"Request revision\",\"ownerReviewApproveDescription\":\"Confirm that you have reviewed the submitted evidence. Approval authorizes release of the tester’s reserved payment and cannot be changed here.\",\"ownerReviewReviseDescription\":\"Tell the tester what to fix. Payment stays held, and the tester has 6 hours to submit a revision.\",\"ownerReviewInstructions\":\"Revision instructions\",\"ownerReviewConfirmApproval\":\"Approve and release payment\",\"ownerReviewSendRevision\":\"Send revision request\",\"ownerReviewSaving\":\"Saving…\",\"ownerReviewSaved\":\"Your decision has been saved.\",\"ownerReviewError\":\"Could not save your decision. Refresh the run and try again.\",\"ownerReviewByOwner\":\"Reviewed by you\",\"ownerReviewByTeam\":\"Reviewed by our team\",\"reviewProcessHumanReview\":\"The AI review couldn't reach a decision, so this submission needs review by our team. There is nothing for you to approve. Payment stays held until that review is complete.\",\"reviewProcessRevision\":\"A revision has been requested for this result and the tester has been asked to resubmit. There is nothing for you to approve. Payment stays held until the revised submission is approved.\",\"reviewProcessAiPending\":\"AI review is in progress. Approved results are paid automatically, and anything the AI cannot decide goes to our team.\",\"stopRunAction\":\"Stop run\",\"stopRunTitle\":\"Stop this user testing run?\",\"stopRunDescription\":\"This closes the selected run to new testers. It does not delete the run or pause its schedule.\",\"stopRunPayoutProtection\":\"Assigned testers keep their current deadlines, and approved work is still paid.\",\"stopRunRefundTiming\":\"Unused funds and failed tester seats are refunded after active work, revisions, payouts, and disputes settle.\",\"stopRunHistory\":\"The run, evidence, payment records, and final report remain available.\",\"stopRunSchedule\":\"Future runs on this recurring schedule will continue as planned.\",\"stopRunConfirm\":\"Stop this run\",\"stopRunStopping\":\"Stopping…\",\"stopRunSuccess\":\"Stop requested for this user testing run.\",\"stopRunError\":\"Could not stop this user testing run. Please try again.\",\"runProgressLabel\":\"User testing run progress\",\"runStageApplicants\":\"Applicants\",\"runStageTesting\":\"Testing\",\"runStageReview\":\"AI review\",\"runStageReport\":\"Report\",\"runSummaryFundingNeeded\":\"Add funds to start this run\",\"runSummaryRecoveryFundingNeeded\":\"Add funds to resume replacement recruiting. Required:\",\"runSummaryReportReady\":\"User testing report ready. AI review complete\",\"runSummaryStopping\":\"Stopping this run. Active tester assignments settling: {count}\",\"runSummaryStopped\":\"Stopped. Tester work, evidence, payments, and history are retained\",\"runSummaryNoQualifiedApplicant\":\"No applicant qualified. Recruiting a replacement\",\"runSummaryNoQualifiedApplicantClosed\":\"No applicant qualified. This run ended before testing started\",\"runSummaryTesterWorking\":\"Testers working on it: {current}/{target}\",\"runSummaryResultUnderReview\":\"Results in AI review: {current}/{target}\",\"runSummaryRevisionsWithPaymentHeld\":\"Revisions pending: {count}. Payment held until approved\",\"runSummaryTesterTimedOut\":\"Testers timed out: {count}. Recruiting replacements\",\"runSummaryRevisionTimedOut\":\"Revision deadlines missed: {count}. Recruiting replacements\",\"runSummaryResultRejected\":\"Results rejected: {count}. Recruiting replacements\",\"runSummaryReplacementPending\":\"Replacing testers: {count}. Recruiting resumes once refunds settle\",\"runSummaryReviewUnavailable\":\"AI review is retrying for {count} result(s). Testers are not penalized\",\"runSummaryStateError\":\"Run state is out of sync. Our team is investigating\",\"runSummaryFinalizingReport\":\"AI review complete. Preparing your report\",\"runSummaryResultsApproved\":\"Results approved: {current}/{target}\",\"runSummaryApplicationsReviewing\":\"AI reviewing applications: {count}\",\"runSummaryWaitingForApplications\":\"Waiting for testers to apply\",\"runSummaryExpired\":\"This run ended before testing started\",\"runSummaryFailed\":\"This run could not be completed\",\"viewFullReport\":\"View full report\",\"viewRunDetails\":\"View run details\",\"addRecoveryFunds\":\"Add recovery funds\",\"viewStageDetails\":\"View stage details\",\"runDetailsTitle\":\"User testing run details\",\"outreachSummary\":\"Tester outreach\",\"outreachSent\"