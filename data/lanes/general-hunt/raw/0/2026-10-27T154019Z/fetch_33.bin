w,color,transform] duration-150 ease-out hover:duration-0 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-midground/30 disabled:pointer-events-none disabled:cursor-not-allowed hermes-button-size-m text-xs bg-[color-mix(in_srgb,var(--hermes-paper)_90%,transparent)] text-[var(--hpv2-brand,var(--hermes-primary))] hover:bg-[var(--hermes-paper)] hover:shadow-[var(--hpv2-shadow-lift)] active:bg-[var(--hermes-paper)] active:shadow-[var(--hpv2-shadow-press)] gap-2 px-3 py-2.5 disabled:bg-[var(--hpv2-row-well,rgb(0_0_0/0.02))] disabled:text-[var(--hpv2-inactive-fg,color-mix(in_srgb,var(--hermes-primary)_40%,transparent))] disabled:shadow-none landing-cta"><span aria-hidden="true" class="relative inline-flex shrink-0 self-center order-first size-[var(--hpv2-icon)]" style="height:0"><span class="absolute top-1/2 flex -translate-y-1/2 items-center justify-center size-[var(--hpv2-icon)]"><img alt="" class="size-full landing-platform-icon landing-platform-icon--linux" height="20" src="https://web-assets.nousresearch.com/marketing/6ae3c5b07622a9219fa0cd2d3cbc2e833d9c5aba/assets/hermes-agent/linux.svg" width="20"/></span></span><span class="leading-none whitespace-nowrap cap-mono text-cap-trim relative -top-[var(--hpv2-cap-nudge)] cap-fallback:top-[var(--hpv2-nudge)]!">Install via terminal</span><span aria-hidden="true" class="hermes-button-hover-border"></span></a></div></article></div></div></section><div class="hw-feature-panel bg-hermes-paper relative w-full overflow-hidden"><section aria-label="Features" class="landing-features" id="features"><div class="mx-auto w-full max-w-[calc(var(--hw-teams-col)+2*var(--hw-teams-pad-x))] px-[var(--hw-teams-pad-x)]"><div class="flex w-full items-start gap-2.5 landing-section-title"><h2 data-type-role="heading" class="text-cap-trim cap-rules text-[var(--hw-teams-ink)]" style="font-family:var(--font-rules-gothic-cnd);font-size:var(--hpv2-type-heading);font-weight:400;line-height:1;letter-spacing:-0.02em;text-transform:none">Features</h2><span class="mt-0.5 size-6 shrink-0 text-[var(--hermes-primary)]"><img alt="" height="24" src="https://web-assets.nousresearch.com/marketing/6ae3c5b07622a9219fa0cd2d3cbc2e833d9c5aba/assets/hermes-agent/features.svg" width="24"/></span></div><div class="landing-feature-grid"><article class="landing-feature"><div class="landing-feature-heading"><p data-type-role="info" class="text-[color:var(--hpv2-text,inherit)]" style="font-family:var(--hpv2-font-meta);font-size:var(--hpv2-type-info);font-weight:400;line-height:1.5;letter-spacing:0;text-transform:uppercase">#1 Connect</p><h3 data-type-role="subheading" class="text-[color:var(--hpv2-text,inherit)] text-cap-trim cap-rules" style="font-family:var(--font-display);font-size:var(--hw-teams-feature-title);font-weight:500;line-height:1.1;letter-spacing:0;text-transform:none">Lives Everywhere</h3></div><p data-type-role="copy" class="text-[color:var(--hpv2-text,inherit)] text-cap-trim cap-rules landing-feature-description" style="font-family:var(--font-body);font-size:var(--hpv2-type-body);font-weight:400;line-height:1.6;letter-spacing:0;text-transform:none">Telegram, Discord, Slack, WhatsApp, Signal, Email, CLI — and a growing list of platforms. One agent, one memory, every surface.</p><div class="landing-feature-art landing-feature-art--feature-connect"><figure class="hw-teams-plate bg-hermes relative h-[var(--hw-teams-plate-h)] w-full overflow-clip rounded-t-md"><div class="hw-noise absolute inset-0"><img alt="" class="hw-parallax absolute inset-0 size-full object-cover" decoding="async" loading="lazy" src="https://web-assets.nousresearch.com/marketing/6ae3c5b07622a9219fa0cd2d3cbc2e833d9c5aba/assets/hermes-agent/feature-connect.webp"/></div></figure></div></article><article class="landing-feature"><div class="landing-feature-heading"><p data-type-role="info" class="text-[color:var(--hpv2-text,inherit)]" style="font-family:var(--hpv2-font-meta);font-size:var(--hpv2-type-info);font-weight:400;line-height:1.5;letter-spacing:0;text-transform:uppercase">#2 Remember</p><h3 data-type-role="subheading" class="text-[color:var(--hpv2-text,inherit)] text-cap-trim cap-rules" style="font-family:var(--font-display);font-size:var(--hw-teams-feature-title);font-weight:500;line-height:1.1;letter-spacing:0;text-transform:none">Persistent Memory</h3></div><p data-type-role="copy" class="text-[color:var(--hpv2-text,inherit)] text-cap-trim cap-rules landing-feature-description" style="font-family:var(--font-body);font-size:var(--hpv2-type-body);font-weight:400;line-height:1.6;letter-spacing:0;text-transform:none">It learns your projects, auto-generates skills, and never forgets how it solved a problem.</p><div class="landing-feature-art landing-feature-art--feature-memory"><figure class="hw-teams-plate bg-hermes relative h-[var(--hw-teams-plate-h)] w-full overflow-clip rounded-t-md"><div class="hw-noise absolute inset-0"><img alt="" class="hw-parallax absolute inset-0 size-full object-cover" decoding="async" loading="lazy" src="https://web-assets.nousresearch.com/marketing/6ae3c5b07622a9219fa0cd2d3cbc2e833d9c5aba/assets/hermes-agent/feature-memory.webp"/></div></figure></div></article><article class="landing-feature"><div class="landing-feature-heading"><p data-type-role="info" class="text-[color:var(--hpv2-text,inherit)]" style="font-family:var(--hpv2-font-meta);font-size:var(--hpv2-type-info);font-weight:400;line-height:1.5;letter-spacing:0;text-transform:uppercase">#3 Schedule</p><h3 data-type-role="subheading" class="text-[color:var(--hpv2-text,inherit)] text-cap-trim cap-rules" style="font-family:var(--font-display);font-size:var(--hw-teams-feature-title);font-weight:500;line-height:1.1;letter-spacing:0;text-transform:none">Focused Automation</h3></div><p data-type-role="copy" class="text-[color:var(--hpv2-text,inherit)] text-cap-trim cap-rules landing-feature-description" style="font-family:var(--font-body);font-size:var(--hpv2-type-body);font-weight:400;line-height:1.6;letter-spacing:0;text-transform:none">Natural-language scheduling for reports, backups, and briefings — running unattended through the gateway, focused every time.</p><div class="landing-feature-art landing-feature-art--feature-automation"><figure class="hw-teams-plate bg-hermes relative h-[var(--hw-teams-plate-h)] w-full overflow-clip rounded-t-md"><div class="hw-noise absolute inset-0"><img alt="" class="hw-parallax absolute inset-0 size-full object-cover" decoding="async" loading="lazy" src="https://web-assets.nousresearch.com/marketing/6ae3c5b07622a9219fa0cd2d3cbc2e833d9c5aba/assets/hermes-agent/feature-automation.webp"/></div></figure></div></article><article class="landing-feature"><div class="landing-feature-heading"><p data-type-role="info" class="text-[color:var(--hpv2-text,inherit)]" style="font-family:var(--hpv2-font-meta);font-size:var(--hpv2-type-info);font-weight:400;line-height:1.5;letter-spacing:0;text-transform:uppercase">#4 Delegate</p><h3 data-type-role="subheading" class="text-[color:var(--hpv2-text,inherit)] text-cap-trim cap-rules" style="font-family:var(--font-display);font-size:var(--hw-teams-feature-title);font-weight:500;line-height:1.1;letter-spacing:0;text-transform:none">Tasks Multiplied</h3></div><p data-type-role="copy" class="text-[color:var(--hpv2-text,inherit)] text-cap-trim cap-rules landing-feature-description" style="font-family:var(--font-body);font-size:var(--hpv2-type-body);font-weight:400;line-height:1.6;letter-spacing:0;text-transform:none">Isolated subagents with their own conversations, terminals, and Python RPC scripts for zero-context-cost pipelines.</p><div class="landing-feature-art landing-feature-art--feature-delegate"><figure class="hw-teams-plate bg-hermes relative h-[var(--hw-teams-plate-h)] w-full overflow-clip rounded-t-md"><div class="hw-noise absolute inset-0"><img alt="" class="hw-parallax absolute inset-0 size-full object-cover" decoding="async" loading="lazy" src="https://web-assets.nousresearch.com/marketing/6ae3c5b07622a9219fa0cd2d3cbc2e833d9c5aba/assets/hermes-agent/feature-delegate.webp"/></div></figure></div></article><article class="landing-feature"><div class="landing-feature-heading"><p data-type-role="info" class="text-[color:var(--hpv2-text,inherit)]" style="font-family:var(--hpv2-font-meta);font-size:var(--hpv2-type-info);font-weight:400;line-height:1.5;letter-spacing:0;text-transform:uppercase">#5 Search</p><h3 data-type-role="subheading" class="text-[color:var(--hpv2-text,inherit)] text-cap-trim cap-rules" style="font-family:var(--font-display);font-size:var(--hw-teams-feature-title);font-weight:500;line-height:1.1;letter-spacing:0;text-transform:none">Browse the Web</h3></div><p data-type-role="copy" class="text-[color:var(--hpv2-text,inherit)] text-cap-trim cap-rules landing-feature-description" style="font-family:var(--font-body);font-size:var(--hpv2-type-body);font-weight:400;line-height:1.6;letter-spacing:0;text-transform:none">Web search, browser automation, vision, image generation, text-to-speech, and multi-model reasoning.</p><div class="landing-feature-art landing-feature-art--feature-search"><figure class="hw-teams-plate bg-hermes relative h-[var(--hw-teams-plate-h)] w-full overflow-clip rounded-t-md"><div class="hw-noise absolute inset-0"><img alt="" class="hw-parallax absolute inset-0 size-full object-cover" decoding="async" loading="lazy" src="https://web-assets.nousresearch.com/marketing/6ae3c5b07622a9219fa0cd2d3cbc2e833d9c5aba/assets/hermes-agent/feature-search.webp"/></div></figure></div></article><article class="landing-feature"><div class="landing-feature-heading"><p data-type-role="info" class="text-[color:var(--hpv2-text,inherit)]" style="font-family:var(--hpv2-font-meta);font-size:var(--hpv2-type-info);font-weight:400;line-height:1.5;letter-spacing:0;text-transform:uppercase">#6 Experiment</p><h3 data-type-role="subheading" class="text-[color:var(--hpv2-text,inherit)] text-cap-trim cap-rules" style="font-family:var(--font-display);font-size:var(--hw-teams-feature-title);font-weight:500;line-height:1.1;letter-spacing:0;text-transform:none">Isolated Sandboxing</h3></div><p data-type-role="copy" class="text-[color:var(--hpv2-text,inherit)] text-cap-trim cap-rules landing-feature-description" style="font-family:var(--font-body);font-size:var(--hpv2-type-body);font-weight:400;line-height:1.6;letter-spacing:0;text-transform:none">Five backends — local, Docker, SSH, Singularity, Modal — with container hardening and namespace isolation.</p><div class="landing-feature-art landing-feature-art--feature-sandbox"><figure class="hw-teams-plate bg-hermes relative h-[var(--hw-teams-plate-h)] w-full overflow-clip rounded-t-md"><div class="hw-noise absolute inset-0"><img alt="" class="hw-parallax absolute inset-0 size-full object-cover" decoding="async" loading="lazy" src="https://web-assets.nousresearch.com/marketing/6ae3c5b07622a9219fa0cd2d3cbc2e833d9c5aba/assets/hermes-agent/feature-sandbox.webp"/></div></figure></div></article></div></div></section><section class="bg-hermes-paper py-[60px]" id="faqs"><div class="mx-auto w-full max-w-[calc(var(--hw-teams-col)+2*var(--hw-teams-pad-x))] px-[var(--hw-teams-pad-x)] flex flex-col gap-5"><div class="flex w-full items-start gap-2.5"><h2 data-type-role="heading" class="text-cap-trim cap-rules text-[var(--hw-teams-ink)]" style="font-family:var(--font-rules-gothic-cnd);font-size:var(--hpv2-type-heading);font-weight:400;line-height:1;letter-spacing:-0.02em;text-transform:none">FAQs</h2><span class="mt-0.5 size-6 shrink-0 text-[var(--hermes-primary)]"><a aria-label="View Docs" class="block" href="https://hermes-agent.nousresearch.com/docs" rel="noopener noreferrer" target="_blank"><svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="block shrink-0 size-6"><path d="M6 4H4v16h2zm10-2H6v2h10zm4 4h-2v14h2zm-2 14H6v2h12zM16 4h2v2h-2zm-4 0h2v6h-2z"></path><path d="M12 8h6v2h-6zm-4 8h8v2H8zm0-4h8v2H8zm0-4h2v2H8z"></path></svg></a></span><div class="ml-auto shrink-0 self-start text-[var(--hw-teams-ink)]"><a href="https://hermes-agent.nousresearch.com/docs" rel="noopener noreferrer" target="_blank" role="link" tabindex="0" data-slot="button" data-variant="ghost" data-size="m" class="hermes-button group relative inline-flex cursor-pointer items-center justify-center rounded-none border-0 bg-clip-padding outline-none select-none font-[family-name:var(--font-mono)] tracking-[0.1em] uppercase transition-[background-color,box-shadow,color,transform] duration-150 ease-out hover:duration-0 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-midground/30 disabled:pointer-events-none disabled:cursor-not-allowed hermes-button-size-m bg-transparent text-current hover:shadow-[var(--hpv2-shadow-hair)] active:shadow-[var(--hpv2-shadow-hair),var(--hpv2-shadow-press)] disabled:opacity-40 disabled:shadow-none gap-2 px-3 py-2.5 h-[var(--hw-teams-btn-h)] text-[length:var(--hw-teams-label)] underline"><span class="leading-none whitespace-nowrap cap-mono text-cap-trim relative -top-[var(--hpv2-cap-nudge)] cap-fallback:top-[var(--hpv2-nudge)]!">View Docs</span><span aria-hidden="true" class="hermes-button-hover-border"></span></a></div></div><div><div class="flex flex-col border-b border-dotted border-[var(--hermes-primary)]" data-surface="white" data-orientation="vertical"><div data-state="closed" data-orientation="vertical" class="border border-transparent transition-colors duration-150 hover:duration-0 has-[button:active]:bg-[var(--hermes-bg-pressed)] relative border-dotted border-t-[var(--hermes-primary)] px-0 py-5 hover:bg-transparent data-[state=open]:bg-transparent" data-surface="white"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-_R_1isluhibqpb_" class="group flex min-h-[38px] flex-1 cursor-pointer items-center gap-2 text-left text-[var(--hermes-primary)] focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-current" data-radix-collection-item=""><span class="min-w-0 flex-1 font-[family-name:var(--font-display)] text-[length:var(--hw-teams-faq-q)] leading-[1.4] font-normal normal-case underline decoration-from-font underline-offset-[var(--hw-underline-offset)]">How does pricing work?</span><svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="block size-3.5 shrink-0 group-data-[state=open]:hidden"><path d="M13 11h7v2h-7v7h-2v-7H4v-2h7V4h2v7Z"></path></svg><svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="hidden size-3.5 shrink-0 group-data-[state=open]:block"><path d="M4 11h16v2H4z"></path></svg></button></h3><div data-state="closed" id="radix-_R_9isluhibqpb_" role="region" aria-labelledby="radix-_R_1isluhibqpb_" data-orientation="vertical" class="overflow-hidden" aria-hidden="true" data-faq-answer="" inert="" style="--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width);position:absolute;top:0;left:0;right:0;visibility:hidden;pointer-events:none"><div class="pt-[var(--space-m)] normal-case max-w-[880px] text-[length:var(--hw-teams-body)] leading-[1.5] text-[var(--hw-teams-ink)]">Hermes Agent is free and open source under the MIT license. Model providers and optional hosted services have their own pricing. You can use your own provider or connect to Nous Portal for model and tool credits; cloud hosting is optional.</div></div></div><div data-state="closed" data-orientation="vertical" class="border border-transparent transition-colors duration-150 hover:duration-0 has-[button:active]:bg-[var(--hermes-bg-pressed)] relative border-dotted border-t-[var(--hermes-primary)] px-0 py-5 hover:bg-transparent data-[state=open]:bg-transparent" data-surface="white"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-_R_2isluhibqpb_" class="group flex min-h-[38px] flex-1 cursor-pointer items-center gap-2 text-left text-[var(--hermes-primary)] focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-current" data-radix-collection-item=""><span class="min-w-0 flex-1 font-[family-name:var(--font-display)] text-[length:var(--hw-teams-faq-q)] leading-[1.4] font-normal normal-case underline decoration-from-font underline-offset-[var(--hw-underline-offset)]">How do I get started?</span><svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="block size-3.5 shrink-0 group-data-[state=open]:hidden"><path d="M13 11h7v2h-7v7h-2v-7H4v-2h7V4h2v7Z"></path></svg><svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="hidden size-3.5 shrink-0 group-data-[state=open]:block"><path d="M4 11h16v2H4z"></path></svg></button></h3><div data-state="closed" id="radix-_R_aisluhibqpb_" role="region" aria-labelledby="radix-_R_2isluhibqpb_" data-orientation="vertical" class="overflow-hidden" aria-hidden="true" data-faq-answer="" inert="" style="--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width);position:absolute;top:0;left:0;right:0;visibility:hidden;pointer-events:none"><div class="pt-[var(--space-m)] normal-case max-w-[880px] text-[length:var(--hw-teams-body)] leading-[1.5] text-[var(--hw-teams-ink)]">Download Hermes Desktop for macOS or Windows, or use the terminal installation command above. Follow the setup steps to connect a model provider, then start a conversation. For an always-on hosted agent, choose Deploy in the cloud.</div></div></div><div data-state="closed" data-orientation="vertical" class="border border-transparent transition-colors duration-150 hover:duration-0 has-[button:active]:bg-[var(--hermes-bg-pressed)] relative border-dotted border-t-[var(--hermes-primary)] px-0 py-5 hover:bg-transparent data-[state=open]:bg-transparent" data-surface="white"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-_R_3isluhibqpb_" class="group flex min-h-[38px] flex-1 cursor-pointer items-center gap-2 text-left text-[var(--hermes-primary)] focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-current" data-radix-collection-item=""><span class="min-w-0 flex-1 font-[family-name:var(--font-display)] text-[length:var(--hw-teams-faq-q)] leading-[1.4] font-normal normal-case underline decoration-from-font underline-offset-[var(--hw-underline-offset)]">How do I chat with my agent?</span><svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="block size-3.5 shrink-0 group-data-[state=open]:hidden"><path d="M13 11h7v2h-7v7h-2v-7H4v-2h7V4h2v7Z"></path></svg><svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="hidden size-3.5 shrink-0 group-data-[state=open]:block"><path d="M4 11h16v2H4z"></path></svg></button></h3><div data-state="closed" id="radix-_R_bisluhibqpb_" role="region" aria-labelledby="radix-_R_3isluhibqpb_" data-orientation="vertical" class="overflow-hidden" aria-hidden="true" data-faq-answer="" inert="" style="--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width);position:absolute;top:0;left:0;right:0;visibility:hidden;pointer-events:none"><div class="pt-[var(--space-m)] normal-case max-w-[880px] text-[length:var(--hw-teams-body)] leading-[1.5] text-[var(--hw-teams-ink)]">Use Hermes Desktop or the terminal, or connect a messaging platform such as Telegram, Discord, Slack, WhatsApp, Signal, or email. The documentation walks you through configuring each integration.</div></div></div><div data-state="closed" data-orientation="vertical" class="border border-transparent transition-colors duration-150 hover:duration-0 has-[button:active]:bg-[var(--hermes-bg-pressed)] relative border-dotted border-t-[var(--hermes-primary)] px-0 py-5 hover:bg-transparent data-[state=open]:bg-transparent" data-surface="white"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-_R_4isluhibqpb_" class="group flex min-h-[38px] flex-1 cursor-pointer items-center gap-2 text-left text-[var(--hermes-primary)] focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-current" data-radix-collection-item=""><span class="min-w-0 flex-1 font-[family-name:var(--font-display)] text-[length:var(--hw-teams-faq-q)] leading-[1.4] font-normal normal-case underline decoration-from-font underline-offset-[var(--hw-underline-offset)]">Does my agent keep its data between sessions?</span><svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="block size-3.5 shrink-0 group-data-[state=open]:hidden"><path d="M13 11h7v2h-7v7h-2v-7H4v-2h7V4h2v7Z"></path></svg><svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="hidden size-3.5 shrink-0 group-data-[state=open]:block"><path d="M4 11h16v2H4z"></path></svg></button></h3><div data-state="closed" id="radix-_R_cisluhibqpb_" role="region" aria-labelledby="radix-_R_4isluhibqpb_" data-orientation="vertical" class="overflow-hidden" aria-hidden="true" data-faq-answer="" inert="" style="--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width);position:absolute;top:0;left:0;right:0;visibility:hidden;pointer-events:none"><div class="pt-[var(--space-m)] normal-case max-w-[880px] text-[length:var(--hw-teams-body)] leading-[1.5] text-[var(--hw-teams-ink)]">Yes. Hermes stores conversations, memories, and skills so you can return to your work in a later session. Keep a backup of your Hermes data directory when moving to another computer.</div></div></div><div data-state="closed" data-orientation="vertical" class="border border-transparent transition-colors duration-150 hover:duration-0 has-[button:active]:bg-[var(--hermes-bg-pressed)] relative border-dotted border-t-[var(--hermes-primary)] px-0 py-5 hover:bg-transparent data-[state=open]:bg-transparent" data-surface="white"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-_R_5isluhibqpb_" class="group flex min-h-[38px] flex-1 cursor-pointer items-center gap-2 text-left text-[var(--hermes-primary)] focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-current" data-radix-collection-item=""><span class="min-w-0 flex-1 font-[family-name:var(--font-display)] text-[length:var(--hw-teams-faq-q)] leading-[1.4] font-normal normal-case underline decoration-from-font underline-offset-[var(--hw-underline-offset)]">What happens when I stop my agent?</span><svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="block size-3.5 shrink-0 group-data-[state=open]:hidden"><path d="M13 11h7v2h-7v7h-2v-7H4v-2h7V4h2v7Z"></path></svg><svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="hidden size-3.5 shrink-0 group-data-[state=open]:block"><path d="M4 11h16v2H4z"></path></svg></button></h3><div data-state="closed" id="radix-_R_disluhibqpb_" role="region" aria-labelledby="radix-_R_5isluhibqpb_" data-orientation="vertical" class="overflow-hidden" aria-hidden="true" data-faq-answer="" inert="" style="--radix-accordion-content-height:var(--radix-collapsible-content-height);--radix-accordion-content-width:var(--radix-collapsible-content-width);position:absolute;top:0;left:0;right:0;visibility:hidden;pointer-events:none"><div class="pt-[var(--space-m)] normal-case max-w-[880px] text-[length:var(--hw-teams-body)] leading-[1.5] text-[var(--hw-teams-ink)]">Stopping a local agent ends its running process, but does not delete its saved conversations, memories, or skills. Start it again to continue. Tasks that need an active agent will not run while it is stopped; hosted agents are managed separately in Nous Portal.</div></div></div></div></div></div></section><section aria-label="Nous Portal plans" class="landing-portal" id="portal"><div class="mx-auto w-full max-w-[calc(var(--hw-teams-col)+2*var(--hw-teams-pad-x))] px-[var(--hw-teams-pad-x)] landing-portal-column"><div aria-label="Available plans" class="landing-plan-chips"><span data-chip="" data-tone="outline" class="inline-flex h-[var(--hpv2-chip-h)] shrink-0 items-center gap-1.5 rounded-r-xs px-1.5 border border-current whitespace-nowrap disabled:pointer-events-none disabled:opacity-50"><span class="hpv2-label-face font-medium uppercase leading-none text-cap-trim inline-flex items-center gap-1.5 text-inherit [&amp;_svg]:size-3 [&amp;_svg]:shrink-0" style="font-family:var(--font-mono);font-size:var(--hpv2-type-label);font-weight:500;line-height:1;text-transform:uppercase">Free</span></span><span data-chip="" data-tone="outline" class="inline-flex h-[var(--hpv2-chip-h)] shrink-0 items-center gap-1.5 rounded-r-xs px-1.5 border border-current whitespace-nowrap disabled:pointer-events-none disabled:opacity-50"><span class="hpv2-label-face font-medium uppercase leading-none text-cap-trim inline-flex items-center gap-1.5 text-inherit [&amp;_svg]:size-3 [&amp;_svg]:shrink-0" style="font-family:var(--font-mono);font-size:var(--hpv2-type-label);font-weight:500;line-height:1;text-transform:uppercase">Plus</span></span><span data-chip="" data-tone="outline" class="inline-flex h-[var(--hpv2-chip-h)] shrink-0 items-center gap-1.5 rounded-r-xs px-1.5 border border-current whitespace-nowrap disabled:pointer-events-none disabled:opacity-50"><span class="hpv2-label-face font-medium uppercase leading-none text-cap-trim inline-flex items-center gap-1.5 text-inherit [&amp;_svg]:size-3 [&amp;_svg]:shrink-0" style="font-family:var(--font-mono);font-size:var(--hpv2-type-label);font-weight:500;line-height:1;text-transform:uppercase">Super</span></span><span data-chip="" data-tone="outline" class="inline-flex h-[var(--hpv2-chip-h)] shrink-0 items-center gap-1.5 rounded-r-xs px-1.5 border border-current whitespace-nowrap disabled:pointer-events-none disabled:opacity-50"><span class="hpv2-label-face font-medium uppercase leading-none text-cap-trim inline-flex items-center gap-1.5 text-inherit [&amp;_svg]:size-3 [&amp;_svg]:shrink-0" style="font-family:var(--font-mono);font-size:var(--hpv2-type-label);font-weight:500;line-height:1;text-transform:uppercase">Ultra</span></span></div><div class="flex w-full items-start gap-2.5 landing-section-title landing-portal-heading"><h2 data-type-role="heading" class="text-cap-trim cap-rules text-[var(--hw-teams-ink)]" style="font-family:var(--font-rules-gothic-cnd);font-size:var(--hpv2-type-heading);font-weight:400;line-height:1;letter-spacing:-0.02em;text-transform:none">Nous Portal</h2><span class="mt-0.5 size-6 shrink-0 text-[var(--hermes-primary)]"><img alt="" height="24" src="https://web-assets.nousresearch.com/marketing/6ae3c5b07622a9219fa0cd2d3cbc2e833d9c5aba/assets/hermes-agent/globe.svg" width="24"/></span><div class="ml-auto shrink-0 self-start text-[var(--hw-teams-ink)]"><div class="landing-portal-actions"><a href="https://portal.nousresearch.com/" role="link" tabindex="0" data-slot="button" data-variant="primary" data-size="m" class="hermes-button group relative inline-flex cursor-pointer items-center justify-center rounded-none border-0 bg-clip-padding outline-none select-none font-[family-name:var(--font-mono)] tra