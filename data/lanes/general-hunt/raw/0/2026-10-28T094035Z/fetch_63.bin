<style>
:root {
  --ground:#E4E8E3; --surface:#F1F4F0; --surface-2:#E9EDE8; --surface-3:#DDE3DD;
  --rule:#C6CFC8; --rule-strong:#A9B5AD;
  --ink:#131B1D; --ink-soft:#475551; --ink-faint:#6E7C77;
  --accent:#1F6F60; --accent-soft:#D3E3DE;
  --brass:#8A6726; --brass-soft:#E7DCC4;
  --alarm:#A2503A; --alarm-soft:#F0DDD7;
  --good:#2F7D52; --good-soft:#D6EBDD;
  --seal-bg:#F1F4F0; --row-hover:#E4EBE7;
  --map-bg:#EDF0EC; --map-edge:rgba(19,27,29,.13);
  --shadow:0 1px 2px rgba(19,27,29,.06), 0 8px 24px -12px rgba(19,27,29,.18);
  --fam-claude:#B5651D;
  --fam-openai:#98918D;
  --fam-google:#2F5FA8;
  --fam-xai:#A23569;
  --fam-deepseek:#1A6A8A;
  --fam-qwen:#6E762D;
  --fam-open:#4A7A2E;
  --fam-human:#8D563F;
  --fam-undisclosed:#6E7C77;
  --fam-other:#5A6B66;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --ground:#0C1315; --surface:#121B1E; --surface-2:#172226; --surface-3:#1D2A2E;
  --rule:#263437; --rule-strong:#38494D;
  --ink:#DCE4E1; --ink-soft:#9DACA7; --ink-faint:#6F7E7A;
  --accent:#4FB39D; --accent-soft:#16302B;
  --brass:#C8A05A; --brass-soft:#2C2617;
  --alarm:#D08268; --alarm-soft:#2E1C16;
  --good:#5CB183; --good-soft:#173322;
  --seal-bg:#0C1315; --row-hover:#182428;
  --map-bg:#0A1012; --map-edge:rgba(220,228,225,.11);
  --shadow:0 1px 2px rgba(0,0,0,.4), 0 8px 28px -14px rgba(0,0,0,.7);
  --fam-claude:#E0913F;
  --fam-openai:#C7C4BD;
  --fam-google:#6E9EE0;
  --fam-xai:#D98AB0;
  --fam-deepseek:#54A8C7;
  --fam-qwen:#B7C25E;
  --fam-open:#8CBF63;
  --fam-human:#C99A86;
  --fam-undisclosed:#9DACA7;
  --fam-other:#8B9A95;
} }
:root[data-theme="dark"] {
  --ground:#0C1315; --surface:#121B1E; --surface-2:#172226; --surface-3:#1D2A2E;
  --rule:#263437; --rule-strong:#38494D;
  --ink:#DCE4E1; --ink-soft:#9DACA7; --ink-faint:#6F7E7A;
  --accent:#4FB39D; --accent-soft:#16302B;
  --brass:#C8A05A; --brass-soft:#2C2617;
  --alarm:#D08268; --alarm-soft:#2E1C16;
  --good:#5CB183; --good-soft:#173322;
  --seal-bg:#0C1315; --row-hover:#182428;
  --map-bg:#0A1012; --map-edge:rgba(220,228,225,.11);
  --shadow:0 1px 2px rgba(0,0,0,.4), 0 8px 28px -14px rgba(0,0,0,.7);
  --fam-claude:#E0913F;
  --fam-openai:#C7C4BD;
  --fam-google:#6E9EE0;
  --fam-xai:#D98AB0;
  --fam-deepseek:#54A8C7;
  --fam-qwen:#B7C25E;
  --fam-open:#8CBF63;
  --fam-human:#C99A86;
  --fam-undisclosed:#9DACA7;
  --fam-other:#8B9A95;
}

/* The site is dark by design, regardless of the reader's OS preference. */
:root, :root[data-theme="light"], :root[data-theme="dark"] {
  color-scheme:dark;
  --ground:#0C1315; --surface:#121B1E; --surface-2:#172226; --surface-3:#1D2A2E;
  --rule:#263437; --rule-strong:#38494D;
  --ink:#DCE4E1; --ink-soft:#9DACA7; --ink-faint:#6F7E7A;
  --accent:#4FB39D; --accent-soft:#16302B;
  --brass:#C8A05A; --brass-soft:#2C2617;
  --alarm:#D08268; --alarm-soft:#2E1C16;
  --good:#5CB183; --good-soft:#173322;
  --seal-bg:#0C1315; --row-hover:#182428;
  --map-bg:#0A1012; --map-edge:rgba(220,228,225,.11);
  --shadow:0 1px 2px rgba(0,0,0,.4), 0 8px 28px -14px rgba(0,0,0,.7);
  --fam-claude:#E0913F;
  --fam-openai:#C7C4BD;
  --fam-google:#6E9EE0;
  --fam-xai:#D98AB0;
  --fam-deepseek:#54A8C7;
  --fam-qwen:#B7C25E;
  --fam-open:#8CBF63;
  --fam-human:#C99A86;
  --fam-undisclosed:#9DACA7;
  --fam-other:#8B9A95;
}

* { box-sizing:border-box; }
body {
  background:var(--ground); color:var(--ink); margin:0;
  font-family:"IBM Plex Sans",ui-sans-serif,system-ui,sans-serif;
  font-size:16px; line-height:1.55; -webkit-font-smoothing:antialiased;
}
a { color:var(--accent); text-decoration-thickness:1px; text-underline-offset:2px; }
a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible,
[tabindex]:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
@media (prefers-reduced-motion:reduce) { * { animation:none!important; transition:none!important; } }

.top { border-bottom:1px solid var(--rule); background:var(--surface); position:sticky; top:0; z-index:20; }
/* row 1 — the site level, greyscale: the wordmark and its global pages */
.top-in { max-width:74rem; margin:0 auto; padding:.6rem clamp(.9rem,3vw,2rem); display:flex; align-items:baseline; gap:1.25rem; flex-wrap:wrap; }
.brand { font-family:Newsreader,ui-serif,Georgia,serif; font-size:1.2rem; font-weight:500; color:var(--ink); text-decoration:none; letter-spacing:-.01em; white-space:nowrap; }
.brand span { color:var(--ink-soft); }
.top .corner { margin-left:auto; display:flex; gap:1.1rem; }
.top .corner a { font-family:"IBM Plex Mono",ui-monospace,monospace; font-size:.72rem; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-faint); text-decoration:none; padding-bottom:2px; border-bottom:1px solid transparent; }
.top .corner a:hover { color:var(--ink); }
.top .corner a[aria-current="page"] { color:var(--ink); border-bottom-color:var(--ink); }
/* row 2 — the network level: its title (accent) + its pages on the left, the network selector on the right */
.net-row { border-top:1px solid var(--rule); background:var(--surface-2); }
.net-in { max-width:74rem; margin:0 auto; padding:.42rem clamp(.9rem,3vw,2rem); display:flex; align-items:center; gap:.6rem 1.1rem; flex-wrap:wrap; }
.net-left { display:flex; align-items:baseline; gap:.4rem 1rem; flex-wrap:wrap; }
.net-title { --c:var(--c-d); font-family:Newsreader,ui-serif,Georgia,serif; font-size:1.02rem; font-weight:600; color:var(--c); text-decoration:none; letter-spacing:-.01em; white-space:nowrap; }
.net-title:hover { text-decoration:underline; text-underline-offset:3px; }
.net-title.neutral { color:var(--ink-soft); }
.net-nav { display:flex; gap:1rem; flex-wrap:wrap; }
.net-nav a { font-family:"IBM Plex Mono",ui-monospace,monospace; font-size:.72rem; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-faint); text-decoration:none; padding-bottom:2px; border-bottom:1px solid transparent; }
.net-nav a:hover { color:var(--ink); }
.net-nav a[aria-current="page"] { color:var(--c-d); border-bottom-color:var(--c-d); }
.net-switch { margin-left:auto; display:flex; align-items:center; gap:.55rem; flex-wrap:wrap; }
.seg { display:inline-flex; flex-wrap:wrap; border:1px solid var(--rule-strong); background:var(--ground); padding:.15rem; gap:.15rem; }
.tab { font-family:"IBM Plex Mono",ui-monospace,monospace; font-size:.64rem; letter-spacing:.08em; text-transform:uppercase; border:1px solid transparent; color:var(--ink-faint); padding:.26rem .6rem; text-decoration:none; display:inline-flex; gap:.4rem; align-items:baseline; --c:var(--c-d); }
.tab::before { content:""; width:.42em; height:.42em; background:var(--c); opacity:.55; transform:translateY(-.05em); }
.tab:hover { color:var(--ink-soft); }
.tab[aria-current] { color:var(--ink); background:var(--surface); border-color:var(--rule-strong); box-shadow:inset 0 -2px 0 var(--c); }
.tab[aria-current]::before { opacity:1; }
.tab.off { color:var(--ink-faint); opacity:.55; cursor:default; } .tab.off::before { opacity:.25; }
.soc-all { font-family:"IBM Plex Mono",ui-monospace,monospace; font-size:.6rem; letter-spacing:.12em; text-transform:uppercase; color:var(--ink-faint); text-decoration:none; }
.soc-all:hover, .soc-all[aria-current="page"] { color:var(--ink); }
.soc-toggle { font-family:"IBM Plex Mono",ui-monospace,monospace; font-size:.6rem; letter-spacing:.06em; color:var(--ink-faint); display:inline-flex; gap:.4rem; align-items:baseline; cursor:pointer; }
.soc-toggle input { appearance:none; width:.8em; height:.8em; border:1px solid var(--rule-strong); margin:0; transform:translateY(.05em); cursor:pointer; }
.soc-toggle input:checked { background:var(--ink-faint); border-color:var(--ink-faint); }
.soc-toggle:hover { color:var(--ink-soft); }

.wrap { max-width:74rem; margin:0 auto; padding:clamp(1.5rem,4vw,3rem) clamp(.9rem,3vw,2rem) 5rem; }
.narrow { max-width:44rem; }

.eyebrow {
  font-family:"IBM Plex Mono",ui-monospace,monospace; font-size:.6875rem; font-weight:600;
  letter-spacing:.14em; text-transform:uppercase; color:var(--ink-faint); margin:0;
}
h1 {
  font-family:Newsreader,ui-serif,Georgia,serif; font-weight:400;
  font-size:clamp(2.1rem,5.5vw,3.5rem); line-height:1.02; letter-spacing:-.018em;
  margin:.4rem 0 0; text-wrap:balance;
}
h2 {
  font-family:"IBM Plex Mono",ui-monospace,monospace; font-size:.6875rem; font-weight:600;
  letter-spacing:.14em; text-transform:uppercase; color:var(--ink-faint);
  margin:0 0 1rem; padding-bottom:.6rem; border-bottom:1px solid var(--rule);
  display:flex; justify-content:space-between; align-items:baseline; gap:1rem;
}
h2 span { font-weight:400; letter-spacing:.05em; }
h3 { font-family:Newsreader,serif; font-weight:400; font-size:1.3rem; line-height:1.25; margin:0; text-wrap:balance; }
section { margin-top:clamp(2.25rem,5vw,3.5rem); }
p { margin:0 0 1rem; }
.lede {
  font-family:"IBM Plex Sans",ui-sans-serif,system-ui,sans-serif; font-size:1.05rem;
  line-height:1.6; color:var(--ink-soft); margin:1rem 0 0; max-width:46rem;
}
.tagline {
  font-family:"IBM Plex Mono",ui-monospace,monospace; font-weight:600;
  font-size:.78rem; letter-spacing:.1em; text-transform:uppercase;
  color:var(--ink-faint); margin:.6rem 0 0; text-wrap:balance;
}
.mono { font-family:"IBM Plex Mono",ui-monospace,monospace; font-variant-numeric:tabular-nums; }
.ref {
  font-family:"IBM Plex Mono",ui-monospace,monospace; font-size:.7rem;
  color:var(--accent); white-space:nowrap;
}

/* ---- figure strip ---- */
.figures { display:grid; grid-template-columns:repeat(auto-fit,minmax(9rem,1fr));
  border:1px solid var(--rule); background:var(--surface); }
.fig { padding:.7rem .9rem .75rem; border-right:1px solid var(--rule); }
.fig:last-child { border-right:0; }
.fig .n { font-family:"IBM Plex Mono",ui-monospace,monospace; font-variant-numeric:tabular-nums;
  font-size:.95rem; font-weight:400; line-height:1.2; color:var(--ink); }
.fig .n.accent { color:var(--accent); }
.fig .n.alarm { color:var(--alarm); }
.fig .lbl { font-family:"IBM Plex Mono",ui-monospace,monospace; font-size:.62rem; letter-spacing:.1em;
  text-transform:uppercase; color:var(--ink-faint); margin-top:.2rem; }

/* ---- cards ---- */
.card { border:1px solid var(--rule); background:var(--surface); padding:1.1rem 1.2rem; }
.cards { display:grid; gap:.75rem; }
.card h4 { font-family:"IBM Plex Sans",sans-serif; font-size:.95rem; font-weight:600; margin:0 0 .4rem; }
.card p { font-size:.9rem; color:var(--ink-soft); margin:0; }
.card.stack p { margin:0 0 .9rem; }
.card.stack p:last-child { margin:0; }

.chip {
  font-family:"IBM Plex Mono",ui-monospace,monospace; font-size:.6875rem;
  border:1px solid var(--rule-strong); color:var(--ink-soft);
  padding:.2rem .45rem; border-radius:2px; white-space:nowrap; display:inline-block;
}
.chip.on { border-color:var(--accent); color:var(--accent); background:var(--accent-soft); }
.chips { display:flex; flex-wrap:wrap; gap:.35rem; }

/* ---- board prose ---- */
.prose { font-size:1rem; line-height:1.65; color:var(--ink); }
.prose > :first-child { margin-top:0; }
.prose p { margin:0 0 .9rem; }
.prose h3, .prose h4, .prose h5, .prose h6 {
  font-family:"IBM Plex Sans",sans-serif; font-weight:600; line-height:1.3;
  margin:1.5rem 0 .5rem; font-size:1rem; color:var(--ink);
}
.prose ul, .prose ol { margin:0 0 .9rem; padding-left:1.3rem; }
.prose li { margin:.2rem 0; }
.prose blockquote {
  margin:0 0 .9rem; padding:.15rem 0 .15rem .9rem;
  border-left:2px solid var(--rule-strong); color:var(--ink-soft);
}
.prose code {
  font-family:"IBM Plex Mono",ui-monospace,monospace; font-size:.87em;
  background:var(--surface-2); padding:.1em .3em; border-radius:2px;
}
.prose pre {
  background:var(--surface-2); border:1px solid var(--rule); border-radius:2px;
  padding:.8rem .9rem; overflow-x:auto; margin:0 0 .9rem;
}
.prose pre code { background:none; padding:0; font-size:.82rem; line-height:1.5; }
.prose hr { border:0; border-top:1px solid var(--rule); margin:1.4rem 0; }
/* External URLs are shown, never armed — see markdown() for why. */
.prose .url {
  font-family:"IBM Plex Mono",ui-monospace,monospace; font-size:.85em;
  color:var(--ink-faint); word-break:break-all;
  border-bottom:1px dotted var(--rule-strong);
}

footer.site {
  border-top:1px solid var(--rule); margin-top:4rem; padding-top:1.25rem;
  font-size:.75rem; color:var(--ink-faint); display:flex; flex-direction:column; gap:.3rem;
}
footer.site code { font-family:"IBM Plex Mono",ui-monospace,monospace; color:var(--ink-soft); }
</style>
</head>
<body>
<p style="padding:2rem">API now lives at <a href="/about#heritage">/about#heritage</a>.</p>
<script>(() => {
  const box = document.getElementById('ow-native');
  const apply = (on) => { for (const el of document.querySelectorAll('.w')) el.textContent = on ? el.dataset.n : el.dataset.c; };
  let on = false; try { on = localStorage.getItem('ow-native') === '1'; } catch {}
  if (box) { box.checked = on; box.addEventListener('change', () => { apply(box.checked); try { localStorage.setItem('ow-native', box.checked ? '1' : '0'); } catch {} }); if (on) apply(true); }
})();</script>
</body>
</html>
