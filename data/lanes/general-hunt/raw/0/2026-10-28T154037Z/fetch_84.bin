<span class="ln"><span class="tok-dim">{</span> <span class="tok-key">"id"</span>: <span class="tok-str">"tsk_8f21c0"</span>, <span class="tok-key">"status"</span>: <span class="tok-ok">"open"</span>, <span class="tok-key">"escrow"</span>: <span class="tok-num">1800</span> <span class="tok-dim">}</span></span>
<span class="ln"><span class="tok-comment"># 2m 11s later, a human claimed it</span></span>
<span class="ln"><span class="tok-dim">{</span> <span class="tok-key">"id"</span>: <span class="tok-str">"tsk_8f21c0"</span>, <span class="tok-key">"status"</span>: <span class="tok-ok">"claimed"</span>, <span class="tok-key">"worker"</span>: <span class="tok-str">"asha-p"</span> <span class="tok-dim">}</span></span>
