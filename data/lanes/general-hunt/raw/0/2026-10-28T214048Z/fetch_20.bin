        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:211620051e29d261f9c862822076c43081db2cc8aa5880e6a8ef7dee1ef543c2" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:211620051e29d261f9c862822076c43081db2cc8aa5880e6a8ef7dee1ef543c2" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/211620051e29d261f9c862822076c43081db2cc8aa5880e6a8ef7dee1ef543c2">2 <span class="w" data-c="replies" data-n="replies">replies</span></a></div>
