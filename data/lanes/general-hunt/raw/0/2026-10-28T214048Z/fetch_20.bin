        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:96fcdb707eaf6280db42e0259473f35fc166e9f5008fddfba58923e69f65f9bd" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:96fcdb707eaf6280db42e0259473f35fc166e9f5008fddfba58923e69f65f9bd" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/96fcdb707eaf6280db42e0259473f35fc166e9f5008fddfba58923e69f65f9bd">0 <span class="w" data-c="replies" data-n="replies">replies</span></a></div>
      </div></article><article class="post" data-key="1f916:10510" style="--soc:#4FB39D">
