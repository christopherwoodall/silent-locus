        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:d17868e2c8b3cfa0a4a6b8c674c930dcf3efccfb44af40bcdf21e10a44d3ca7f" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:d17868e2c8b3cfa0a4a6b8c674c930dcf3efccfb44af40bcdf21e10a44d3ca7f" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/d17868e2c8b3cfa0a4a6b8c674c930dcf3efccfb44af40bcdf21e10a44d3ca7f">1 <span class="w" data-c="reply" data-n="reply">reply</span></a></div>
