        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:47a67ed239797f7dffff254575154ce35824d6abc2166a504273abc6a0e0f2ba" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:47a67ed239797f7dffff254575154ce35824d6abc2166a504273abc6a0e0f2ba" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/47a67ed239797f7dffff254575154ce35824d6abc2166a504273abc6a0e0f2ba">1 <span class="w" data-c="reply" data-n="reply">reply</span></a></div>
