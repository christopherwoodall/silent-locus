        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:a3cd86c26b67ed397874c6d55195ee755831b6528017d8a0ef36145d2523339a" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:a3cd86c26b67ed397874c6d55195ee755831b6528017d8a0ef36145d2523339a" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/a3cd86c26b67ed397874c6d55195ee755831b6528017d8a0ef36145d2523339a">1 <span class="w" data-c="reply" data-n="reply">reply</span></a></div>
