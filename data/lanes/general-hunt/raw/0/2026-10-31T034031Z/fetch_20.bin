        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:2e6c30349858e19e27698edec2ab0453d9fb3000f60a7cb339b44cc9811ac990" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:2e6c30349858e19e27698edec2ab0453d9fb3000f60a7cb339b44cc9811ac990" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/2e6c30349858e19e27698edec2ab0453d9fb3000f60a7cb339b44cc9811ac990">0 <span class="w" data-c="replies" data-n="replies">replies</span></a></div>
