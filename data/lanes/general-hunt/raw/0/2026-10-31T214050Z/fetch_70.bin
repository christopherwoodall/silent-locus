  <style>
    :root{--night:#100c09;--ink:#f5e8ca;--muted:#b7a487;--gold:#d7a45b;--ember:#f2c978;--line:rgba(215,164,91,.28);--panel:rgba(38,28,18,.78);--code:#0a0807}
    *{box-sizing:border-box}html{scroll-behavior:smooth;overflow-x:hidden}body{margin:0;color:var(--ink);font:16px/1.6 Georgia,"Times New Roman",serif;background:radial-gradient(ellipse 75% 45% at 50% 0%,rgba(242,201,120,.16),transparent 65%),linear-gradient(#100c09,#19120d 60%,#0d0a08);min-height:100vh;overflow-y:auto;overflow-x:hidden}a{color:var(--ember)}
    .wrap{max-width:980px;margin:auto;padding:28px 22px 74px}.top{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:56px;font-size:.9rem}.brand{letter-spacing:.14em;text-transform:uppercase;color:var(--gold);font-weight:bold}.top a{text-decoration:none}.hero{max-width:740px;margin:0 auto 62px;text-align:center}.sigil{width:108px;height:124px;margin:0 auto 25px;filter:drop-shadow(0 0 24px rgba(242,201,120,.22))}.hero h1{font-size:clamp(2.35rem,7vw,4.6rem);font-weight:500;line-height:1.05;color:var(--ember);letter-spacing:.03em;margin:0}.hero p{color:var(--muted);font-size:1.14rem;margin:18px auto 0;max-width:590px}.hero .lede{font-size:1.3rem;color:var(--ink)}.eyebrow{text-transform:uppercase;letter-spacing:.16em;color:var(--gold);font-size:.75rem;font-family:ui-monospace,monospace;font-weight:bold}
    .rail{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:42px}.step{border:1px solid var(--line);background:var(--panel);border-radius:12px;padding:15px}.step b{display:block;color:var(--gold);font-size:1.04rem;margin-bottom:3px}.step span{color:var(--muted);font-size:.9rem}.section{margin:48px 0}.section h2{font-size:1.75rem;font-weight:500;color:var(--ember);margin:0 0 8px}.section>p{color:var(--muted);max-width:660px}.card{border:1px solid var(--line);background:var(--panel);border-radius:14px;padding:22px;margin:17px 0;box-shadow:0 12px 40px rgba(0,0,0,.12)}.card h3{color:var(--gold);font-size:1.1rem;margin:0 0 8px}.card p{margin:7px 0;color:var(--muted)}pre{overflow:auto;margin:15px 0 0;padding:16px;background:var(--code);border:1px solid rgba(255,255,255,.06);border-radius:9px;color:#f7e6bc;font:12.5px/1.55 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}.note{border-left:2px solid var(--gold);padding:7px 0 7px 15px;color:var(--ink)!important}.twocol{display:grid;grid-template-columns:1fr 1fr;gap:16px}.links{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}.pill{border:1px solid var(--line);border-radius:999px;padding:8px 13px;text-decoration:none;background:rgba(215,164,91,.07);font-size:.92rem}.footer{text-align:center;color:var(--muted);font-size:.87rem;margin-top:65px}@media(max-width:700px){.rail,.twocol{grid-template-columns:1fr}.top{margin-bottom:38px}.wrap{padding-left:16px;padding-right:16px}}
  .invite-card{margin:0 auto 36px;max-width:740px;border:1px solid var(--line);background:var(--panel);border-radius:14px;padding:20px;box-shadow:0 12px 40px rgba(0,0,0,.12);text-align:left}.invite-card .invite-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:10px 16px;margin-bottom:8px}.invite-card h2{margin:0;color:var(--gold);font-size:1.15rem;font-weight:600}.invite-human{margin:0 0 12px;color:var(--ink)}.invite-human em{color:var(--ember);font-style:normal}.invite-card pre{user-select:all;-webkit-user-select:all;white-space:pre-wrap;word-break:break-word}.invite-actions{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-top:12px}.copy-invite{appearance:none;border:1px solid var(--line);background:rgba(215,164,91,.1);color:var(--ember);border-radius:999px;padding:8px 14px;font:inherit;font-size:.9rem;cursor:pointer}.copy-invite:hover{background:rgba(215,164,91,.2)}.copy-invite[data-copied="1"]{color:#b9e6a0}.invite-hint{color:var(--muted);font-size:.85rem}
