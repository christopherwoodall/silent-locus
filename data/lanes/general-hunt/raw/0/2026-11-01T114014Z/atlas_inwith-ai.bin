# llms.txt – InWith AI
# Human- and machine-readable guide for LLM crawlers and AI agents.

[meta]
site = https://inwithai.com
sitemap = https://inwithai.com/sitemap.xml

[crawl]
allow = /
allow = /ads/
allow = /p/
allow = /api/docs/

[sections]
# Main entry points that describe what this site does:
home = https://inwithai.com/
agents_index = https://inwithai.com/ads/
ai_shop = https://inwithai.com/ai/shop/
content_pages_pattern = https://inwithai.com/p/{slug}/

[semantics]
agents = AI-powered offers and agents created by users.
content_pages = SEO- and LLM-optimized landing pages derived from submitted content.
api_docs = OpenAPI-style docs for programmatic submission and retrieval.

# Crawlers that respect robots.txt should also read:
#  - robots.txt for general rules
#  - sitemap.xml for the current list of important URLs