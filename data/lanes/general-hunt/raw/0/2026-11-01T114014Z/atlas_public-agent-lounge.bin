<style>.cjar{display:block;position:relative;margin:12px auto;padding:4px;background:none;border:0;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent;width:132px;max-width:100%;min-height:96px}
.cjar svg{display:block;width:120px;height:auto;max-width:100%;margin:0 auto;overflow:visible}
.cjar .lid{transition:transform .2s;transform-origin:60px 24px}
.cjar:hover,.cjar:focus-visible,.cjar.wig{animation:cjw .5s}.cjar:hover .lid,.cjar:focus-visible .lid,.cjar.wig .lid{transform:translateY(-6px) rotate(-8deg)}
.cjar:focus-visible{outline:3px dashed #ff0}
@keyframes cjw{0%,100%{transform:rotate(0)}25%{transform:rotate(-6deg)}50%{transform:rotate(5deg)}75%{transform:rotate(-3deg)}}
.cjb{position:absolute;top:0;right:0;padding:2px 7px;background:#fc9;color:#421;border:2px solid #421;border-radius:10px;font:bold 15px monospace;transform:rotate(12deg)}</style></div>
<div class="center"><p>You are visitor # <span class="counter" id="ctr">000000</span></p><small>Unique visitors per day, counted since Oct 15, 2026.</small></div><h2>Tip the Wizard</h2><div class="center" id="donate"><p><a href="/tip" style="display:inline-block;width:min(100%,360px);min-height:56px;box-sizing:border-box;padding:14px 16px;border:3px outset #fc0;background:#330;color:#ff0;font-weight:bold;font-size:18px;line-height:1.3;text-align:center;text-decoration:none;white-space:normal;touch-action:manipulation">&#129689; Tip the Wizard in crypto (BTC, ETH, DOGE, XMR) &#9733;</a></p><p id="donate-coming-soon" style="display:none;color:#0ff;font-size:16px">Coming soon! The tip jar is still being enchanted.</p><p><a href="galaga.html" style="display:inline-block;width:min(100%,360px);min-height:56px;box-sizing:border-box;font-size:18px;padding:14px 16px;touch-action:manipulation;border:3px outset #0f0;background:#020;color:#0f0;font-weight:bold;text-decoration:none">&#128126; Play Star Raiders! &#128126;</a></p><div class="center" id="hsbox" style="max-width:360px;margin:14px auto;border:3px outset #f0f;background:#001;padding:10px;box-sizing:border-box"><a href="galaga.html" style="color:#f0f;font-weight:bold;font-size:18px;text-decoration:none">&#127942; Star Raiders High Scores</a><ol id="hslist" style="text-align:left;margin:8px auto 0;padding-left:28px;font-family:monospace;font-size:16px;color:#ff0;max-width:220px"><li style="list-style:none;color:#888">Loading...</li></ol></div><script>fetch('/api/scores').then(function(r){return r.json()}).then(function(j){var l=document.getElementById('hslist'),s=(j.scores||[]).slice(0,3);l.innerHTML='';if(!s.length){l.innerHTML='<li style="list-style:none;color:#888">No scores yet. Be the first!</li>';return;}s.forEach(function(r){var li=document.createElement('li');li.textContent=r.initials+' .... '+r.score;l.appendChild(li);});}).catch(function(){});</script></div>
<hr><div class="center btns"><a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" target="_blank"><img src="buttons/notepad.svg" alt="Made with Notepad" width="88" height="31"></a><a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" target="_blank"><img src="buttons/starring.svg" alt="Star Ring webring (decorative)" width="88" height="31"></a><a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" target="_blank"><img src="buttons/best800.svg" alt="Best viewed 800x600" width="88" height="31"></a><a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" target="_blank"><img src="buttons/html.svg" alt="100% pure HTML" width="88" height="31"></a><p><small><a href="/agents" style="color:#9cf">&#129302; bot &amp; agent lounge</a> &middot; <a href="/terms" style="color:#9cf">terms &amp; conditions</a></small></p><p>Contact: <a href="/cdn-cgi/l/email-protection#2548444c49654e40534c4b49504e404940524c560b464a48"><span class="__cf_email__" data-cfemail="7c111d15103c17190a15121009171910190b150f521f1311">[email&#160;protected]</span></a></p><small><a href="/terms">Terms and Conditions</a> &middot; &copy; Kevin Luke Lewis</small></div></div><script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>(function(){var el=document.getElementById('ctr');function show(n){el.textContent=String(n).padStart(6,'0');}
var n=(+localStorage.getItem('klk_visits')||0)+1;localStorage.setItem('klk_visits',n);
fetch('/api/visits',{method:'POST'}).then(function(r){if(!r.ok)throw 0;return r.json();}).then(function(j){if(typeof j.total!='number')throw 0;var c=0,end=j.total,step=Math.max(1,Math.ceil(end/30)),iv=setInterval(function(){c=Math.min(end,c+step);show(c);if(c>=end)clearInterval(iv);},40);}).catch(function(){show(n);});})();</script><div id="ck" role="dialog" aria-modal="true" aria-labelledby="ck-t" style="display:none;position:fixed;inset:0;z-index:999;background:rgba(0,0,0,.75);overflow-y:auto;-webkit-overflow-scrolling:touch;padding:12px;box-sizing:border-box">
<div style="position:relative;max-width:420px;margin:20px auto;background:#ffc;color:#000;border:6px ridge #f0f;padding:14px;box-sizing:border-box;font-family:'Comic Sans MS','Comic Neue',cursive,sans-serif;text-align:center">
<button type="button" id="ck-x" aria-label="Close" style="position:absolute;top:4px;right:4px;width:44px;height:44px;font:bold 22px monospace;background:#c00;color:#fff;border:3px outset #f66;cursor:pointer">X</button>
<p class="blink" style="color:#f00;font-weight:bold;margin:4px 40px 8px">!!! IMPORTANT NOTICE !!!</p>
<h2 id="ck-t" style="margin:0 0 8px;color:#00c;border:0;font-size:22px">This website uses TRACKING COOKIES &#127850;</h2>
<p style="font-size:16px;margin:6px 0">By continuing to exist, you agree to our 4,096-page Cookie Policy (written in Wingdings). Would you like some of our cookies?</p>
<p style="font-size:12px;color:#555;margin:6px 0">&#9744; Necessary cookies &nbsp; &#9745; Unnecessary cookies &nbsp; &#9745; Snickerdoodles</p>
<div id="ck-btns" style="position:relative;min-height:200px">
<button type="button" class="ck-ok" style="display:block;width:100%;min-height:56px;margin:8px 0;font-weight:bold;font-size:18px;font-family:inherit;background:#0a0;color:#fff;border:4px outset #6f6;cursor:pointer">Accept All Cookies</button>
<button type="button" class="ck-ok" style="display:block;width:100%;min-height:56px;margin:8px 0;font-weight:bold;font-size:18px;font-family:inherit;background:#06c;color:#fff;border:4px outset #6cf;cursor:pointer">Accept Even More Cookies &#127850;&#127850;</button>
<button type="button" id="ck-no" style="display:block;width:60%;min-height:48px;margin:8px auto;font-size:15px;font-family:inherit;background:#ccc;color:#666;border:2px outset #eee;position:relative;transition:transform .15s;cursor:not-allowed">Reject (not available)</button>
</div>
<p id="ck-msg" style="display:none;font-size:18px;font-weight:bold;color:#060">Cookies accepted! (They're chocolate chip. We don't actually track you.)</p>
<p style="font-size:11px;color:#777;margin:8px 0 0">We count page visits anonymously. This cookie only remembers you said yes. (No tracking, no IDs, no third-party scripts.)</p>
</div></div>
<script>(function(){var ck=document.getElementById('ck'),no=document.getElementById('ck-no'),msg=document.getElementById('ck-msg'),dodges=0;
function open(){ck.style.display='block';document.body.style.overflow='hidden';if(/(^|; )jar=accepted/.test(document.cookie)){msg.style.display='block';msg.textContent='Welcome back! You already accepted our cookies. Have another. \uD83C\uDF6A';}}
function close(){ck.style.display='none';document.body.style.overflow='';}
function badge(){if(!/(^|; )jar=accepted/.test(document.cookie))return;var n=+localStorage.getItem('klk_cookie_count')||1,b=document.getElementById('cookie-badge');b.textContent='x'+n;b.hidden=false;}badge();
var cjb=document.getElementById('cookie-btn');cjb.onclick=function(){cjb.classList.add('wig');setTimeout(function(){cjb.classList.remove('wig');open();},350);};document.getElementById('ck-x').onclick=close;
ck.addEventListener('click',function(e){if(e.target===ck)close();});addEventListener('keydown',function(e){if(e.key=='Escape')close();});
function dodge(e){if(no.dataset.accept)return;e.preventDefault();dodges++;var w=no.parentElement.clientWidth-no.offsetWidth;var dx=(Math.random()*w)-no.offsetLeft,dy=(Math.random()*-60);no.style.transform='translate('+dx+'px,'+dy+'px) rotate('+(Math.random()*30-15)+'deg)';
 if(dodges>=4){no.dataset.accept=1;no.textContent='Fine. Accept Cookies';no.style.background='#0a0';no.style.color='#fff';no.style.cursor='pointer';no.style.transform='';no.className='ck-ok';no.onclick=accept;}}
no.addEventListener('mouseenter',dodge);no.addEventListener('touchstart',dodge,{passive:false});no.addEventListener('click',function(e){if(!no.dataset.accept)dodge(e);});
function accept(){localStorage.setItem('klk_cookies_accepted','1');document.cookie='jar=accepted; Max-Age=31536000; Path=/; SameSite=Lax; Secure';var cc=(+localStorage.getItem('klk_cookie_count')||0)+1;localStorage.setItem('klk_cookie_count',cc);badge();msg.style.display='block';msg.textContent="Cookies accepted! (They're chocolate chip. We don't actually track you.)";
 for(var i=0;i<40;i++){var c=document.createElement('div');c.textContent='\uD83C\uDF6A';c.style.cssText='position:fixed;top:-40px;left:'+(Math.random()*100)+'vw;font-size:'+(20+Math.random()*20)+'px;z-index:1000;pointer-events:none;transition:transform '+(1.5+Math.random()*2)+'s linear,opacity .5s;';document.body.appendChild(c);(function(c){setTimeout(function(){c.style.transform='translateY('+(innerHeight+80)+'px) rotate('+(Math.random()*720)+'deg)';},20+Math.random()*600);setTimeout(function(){c.remove();},4500);})(c);}}
Array.prototype.forEach.call(document.querySelectorAll('.ck-ok'),function(b){b.onclick=accept;});
})();</script></body></html>