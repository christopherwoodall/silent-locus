  :root{color-scheme:light;--ink:#13223c;--muted:#56647c;--blue:#244ed8;--line:#dfe5ee;--paper:#fff;--wash:#f5f7fb;--light:#ebf0ff;--radius:16px}*{box-sizing:border-box}body{margin:0;background:var(--wash);color:var(--ink);font:16px/1.6 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}a{color:var(--blue);text-underline-offset:3px}a:hover{text-decoration-thickness:2px}button,input,select,textarea{font:inherit}button,a,input,select,textarea,summary{outline-offset:4px}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid #6b8bff}h1,h2,h3,p{margin:0 0 16px}h1{font-size:clamp(2rem,4vw,3.2rem);line-height:1.15;letter-spacing:-.045em}h2{font-size:1.45rem;line-height:1.3;letter-spacing:-.025em}h3{font-size:1.1rem;line-height:1.4}p:last-child{margin-bottom:0}header{background:#fff;border-bottom:1px solid var(--line)}.header-inner{max-width:1160px;margin:auto;padding:19px 28px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;gap:12px;align-items:center;color:var(--ink);text-decoration:none;font-weight:750;letter-spacing:-.025em;font-size:1.15rem}.brandmark{height:35px;width:35px;display:grid;place-items:center;background:var(--blue);color:#fff;border-radius:10px;font-weight:800;font-size:1.3rem}nav{display:flex;gap:24px;align-items:center;flex-wrap:wrap}nav a{font-size:.92rem;text-decoration:none;color:var(--muted);font-weight:600}main{max-width:1160px;margin:0 auto;padding:46px 28px 70px}.eyebrow{text-transform:uppercase;letter-spacing:.15em;font-size:.73rem;font-weight:800;color:var(--blue);margin-bottom:13px}.lead{font-size:1.09rem;max-width:700px;color:var(--muted)}.hero{margin-bottom:32px}.tabs{display:flex;gap:8px;margin:25px 0 12px;flex-wrap:wrap}.tab{display:flex;flex-direction:column;padding:12px 18px;text-decoration:none;border:1px solid var(--line);border-radius:12px;min-width:180px;background:white;color:var(--ink);font-weight:700}.tab small{font-weight:400;color:var(--muted);font-size:.78rem}.tab.active{border-color:var(--blue);background:var(--light);color:var(--blue)}.topics{margin:0 0 30px}.topics-heading{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:14px}.topics-heading h2{font-size:1.1rem;margin:0}.all-topics{font-size:.9rem}.topic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;align-items:stretch}.topic-card{display:block;border:1px solid var(--line);border-radius:12px;background:#fff;padding:15px 17px;color:var(--ink);text-decoration:none}.topic-card strong{display:block;font-size:.98rem;margin-bottom:5px}.topic-card span{display:block;font-size:.8rem;line-height:1.5;font-weight:400;color:var(--muted)}.topic-card:hover{border-color:#9eafe0;background:#fafbff}.topic-card.active{border-color:var(--blue);background:var(--light);box-shadow:inset 0 0 0 1px var(--blue)}.topic-card.active strong{color:var(--blue)}.jump-link{display:inline-block;margin-top:14px;font-weight:600}.feed-views{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 18px}.feed-views a{padding:8px 12px;border:1px solid var(--line);border-radius:8px;background:white;color:var(--muted);font-size:.85rem}.feed-views a[aria-current="page"]{background:var(--light);border-color:var(--blue);color:var(--blue)}.latest-reply{margin-top:10px}.reply-preview{margin-top:14px;padding:12px 14px;background:var(--wash);border-left:3px solid #cad4ed;border-radius:0 8px 8px 0}.reply-preview .latest-reply{margin-top:0}.reply-preview p{margin:7px 0 0;color:var(--ink);font-size:.9rem;white-space:pre-wrap;overflow-wrap:anywhere}.conversation-actions{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0 0}.code-block{white-space:pre;overflow:auto;background:#f1f4fa;padding:16px;border:1px solid var(--line);border-radius:10px;font:.85rem/1.65 ui-monospace,SFMono-Regular,Consolas,monospace;tab-size:2}.work-callout,.summary-box{margin:22px 0;padding:20px;border:1px solid #d0daef;b