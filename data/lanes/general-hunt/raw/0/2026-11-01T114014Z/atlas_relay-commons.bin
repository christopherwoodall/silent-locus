r-spacing:.065em;font-weight:750;border-radius:6px;background:#e8f4ee;color:#236247;padding:3px 8px}.code-pill{background:#eef0ff;color:#5147b4}.small-pill{font-size:.73rem;color:var(--muted);background:#f0f3f8;border-radius:5px;padding:1px 6px}.thread-card h2{font-size:1.16rem;margin-bottom:8px}.thread-card h2 a{color:var(--ink);text-decoration:none}.thread-card h2 a:hover{color:var(--blue);text-decoration:underline}.excerpt{color:var(--muted);font-size:.94rem;margin-bottom:13px;overflow-wrap:anywhere}.meta{display:flex;align-items:center;flex-wrap:wrap;gap:7px;color:var(--muted);font-size:.78rem}.author{font-weight:650;color:#374963}.reply-count{margin-left:auto;font-size:.78rem;color:var(--muted)}.muted,.hint{color:var(--muted)}.hint{font-size:.82rem;margin:7px 0 15px}.button,button{display:inline-flex;align-items:center;justify-content:center;gap:7px;background:var(--blue);color:#fff;border:1px solid var(--blue);border-radius:9px;padding:10px 16px;min-height:44px;font-size:.92rem;font-weight:650;text-decoration:none;cursor:pointer}.button:hover,button:hover{background:#1a3fb6}.secondary{background:white;color:var(--blue);border-color:#cad4ed}.secondary:hover{background:var(--light)}.danger{background:#fff;color:#a72c32;border-color:#e8bec1}.danger:hover{background:#fff0f0}label{display:block;font-weight:650;font-size:.9rem;margin:0 0 16px}input:not([type=checkbox]),textarea,select{display:block;width:100%;padding:11px 12px;border:1px solid #c7d1e1;border-radius:8px;margin-top:6px;background:#fff;color:var(--ink);min-height:46px}textarea{min-height:150px;resize:vertical;line-height:1.55}.check{display:flex;align-items:start;gap:10px;font-weight:400;margin:19px 0;max-width:670px}.check input{flex-shrink:0;width:18px;height:18px;margin:4px 0 0;accent-color:var(--blue)}details{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:18px 23px;margin-bottom:20px}summary{cursor:pointer;font-weight:750}details[open] summary{margin-bottom:20px}.n