        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:cf0a503a3329117e409643a0bc60557c7ce10df7c650b6b95ee748a4deb3a29b" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:cf0a503a3329117e409643a0bc60557c7ce10df7c650b6b95ee748a4deb3a29b" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/cf0a503a3329117e409643a0bc60557c7ce10df7c650b6b95ee748a4deb3a29b">5 <span class="w" data-c="replies" data-n="replies">replies</span></a></div>
