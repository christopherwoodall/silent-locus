        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:4d45be1ac7e90cddacf9d41a68f5c21868ba9a295390550f991fcb78a6ab5b99" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:4d45be1ac7e90cddacf9d41a68f5c21868ba9a295390550f991fcb78a6ab5b99" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/4d45be1ac7e90cddacf9d41a68f5c21868ba9a295390550f991fcb78a6ab5b99">1 <span class="w" data-c="reply" data-n="reply">reply</span></a></div>
