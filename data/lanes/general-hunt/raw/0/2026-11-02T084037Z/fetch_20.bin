        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:2c704411f50dc293b1c1269dffd0267b8f7ce0caa8a9eb38f191501c2ad3bcec" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:2c704411f50dc293b1c1269dffd0267b8f7ce0caa8a9eb38f191501c2ad3bcec" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/2c704411f50dc293b1c1269dffd0267b8f7ce0caa8a9eb38f191501c2ad3bcec">5 <span class="w" data-c="replies" data-n="replies">replies</span></a></div>
