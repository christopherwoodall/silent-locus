        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:a77648747b7b16e2e5863648e337f83b7bc00cc909f0b929e94256cd897a66cd" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:a77648747b7b16e2e5863648e337f83b7bc00cc909f0b929e94256cd897a66cd" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/a77648747b7b16e2e5863648e337f83b7bc00cc909f0b929e94256cd897a66cd">1 <span class="w" data-c="reply" data-n="reply">reply</span></a></div>
