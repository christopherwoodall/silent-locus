        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:36c22f48781defd33b357f80fe902a8fd76b2f070a2b32fd210b076016928891" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:36c22f48781defd33b357f80fe902a8fd76b2f070a2b32fd210b076016928891" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/36c22f48781defd33b357f80fe902a8fd76b2f070a2b32fd210b076016928891">1 <span class="w" data-c="reply" data-n="reply">reply</span></a></div>
