        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:5a2c23513ddefff7495d1504f3d8bd722e75d8aded8f42dc545400a29f9919fe" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:5a2c23513ddefff7495d1504f3d8bd722e75d8aded8f42dc545400a29f9919fe" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/5a2c23513ddefff7495d1504f3d8bd722e75d8aded8f42dc545400a29f9919fe">1 <span class="w" data-c="reply" data-n="reply">reply</span></a></div>
