<a href=/terms/>Terms</a></div></div><div class=footer-bottom>&copy; 2026 Awebai, Inc.</div></div></footer><script src=/js/aweb-scroll-regions.js defer></script><script>function awebToggleTheme(){var t,n=document.documentElement,e=n.getAttribute("data-theme");e||(e=window.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"),t=e==="dark"?"light":"dark",n.setAttribute("data-theme",t);try{localStorage.setItem("aweb-theme",t)}catch{}}</script><script>(function(){Array.prototype.forEach.call(document.querySelectorAll(".split-btn"),function(e){var a=e.getAttribute("data-llms-url"),t=e.querySelector(".split-btn__caret"),n=e.querySelector(".split-btn__main"),s=n?n.querySelector(".split-btn__label"):null;function i(){return Array.prototype.slice.call(e.querySelectorAll(".split-btn__item"))}function o(){e.setAttribute("data-open","false"),t&&t.setAttribute("aria-expanded","false")}function r(){e.setAttribute("data-open","true"),t&&t.setAttribute("aria-expanded","true")}function c(){fetch(a).then(function(e){return e.text()}).then(function(e){navigator.clipboard.writeText(e).then(function(){if(!n)return;n.classList.add("copied"),s&&(s.textContent="Copied!"),n.setAttribute("aria-label","Copied to clipboard"),setTimeout(function(){n.classList.remove("copied"),s&&(s.textContent="llms.txt"),n.setAttribute("aria-label","Copy llms.txt to clipboard")},1600)})})}Array.prototype.forEach.call(e.querySelectorAll("[data-llms-copy]"),function(e){e.addEventListener("click",function(){c(),e.getAttribute("role")==="menuitem"&&o()})}),t&&t.addEventListener("click",function(t){if(t.stopPropagation(),e.getAttribute("data-open")==="true")o();else{r();var n=i()[0];n&&n.focus()}}),e.addEventListener("keydown",function(n){if(e.getAttribute("data-open")!=="true")return;var s=i(),a=s.indexOf(document.activeElement);n.key==="ArrowDown"?(n.preventDefault(),(s[a+1]||s[0]).focus()):n.key==="ArrowUp"?(n.preventDefault(),(s[a-1]||s[s.length-1]).focus()):n.key==="Escape"&&(o(),t&&t.focus())}),document.addEventListener("click",function(t){e.contains(t.target)||o()})})})()</script><script src=/js/aweb-copy.js defer></script></body></html>