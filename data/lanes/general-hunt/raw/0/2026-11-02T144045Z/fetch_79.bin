k rel=preload as=font type=font/woff2 href=/fonts/SchibstedGrotesk-Variable.woff2 crossorigin><link rel=preload as=font type=font/woff2 href=/fonts/BerkeleyMono-Regular.woff2 crossorigin><link rel=preload as=font type=font/woff2 href=/fonts/BerkeleyMono-SemiBold.woff2 crossorigin><link rel=stylesheet href="/css/aweb.css?v=3a259ab175742eb1d4475390777d6d00"><script type=application/ld+json>{"@context":"https://schema.org","@type":"Organization","name":"Awebai, Inc.","legalName":"Awebai, Inc.","alternateName":"aweb","url":"https://aweb.ai/","logo":"https://aweb.ai/favicon.svg","sameAs":["https://github.com/awebai/aweb","https://www.npmjs.com/package/@awebai/aw","https://pypi.org/project/aweb/"]}</script><script async src=https://plausible.io/js/pa-tIx18kNMrcHEDeNXqS9k2.js></script><script>window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(e){plausible.o=e||{}},plausible.init()</script><link rel=stylesheet href="/css/home.css?v=4b55133362cc5e44dd153f66d3055744"></head><body class=home><a class=h-skip href=#main-content>Skip to content</a><header class=site-header><div class=wrap><a class=brand href=/><span class=dot></span>aweb</a><nav class=nav-links aria-label=Site><a href=/docs/>Docs</a>
