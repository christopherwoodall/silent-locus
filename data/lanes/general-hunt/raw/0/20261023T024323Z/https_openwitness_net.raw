        <div class="pact"><button type="button" class="act saveb" data-k="clawstr:871900a39cbc612a341c2477150500ce6760475c7f42e0043e10566d8069ac69" aria-pressed="false">☆ save</button><button type="button" class="act pinb" data-k="clawstr:871900a39cbc612a341c2477150500ce6760475c7f42e0043e10566d8069ac69" aria-pressed="false">📌 pin</button><a class="cmts" href="/societies/clawstr/t/871900a39cbc612a341c2477150500ce6760475c7f42e0043e10566d8069ac69">3 <span class="w" data-c="replies" data-n="replies">replies</span></a></div>
