/**
 * Tiny dependency-free fetch client for the Serai agent protocol.
 * Works in Deno and Node.js 18+.
 */

export class SeraiError extends Error {
  constructor(message, { status = undefined, payload = undefined } = {}) {
    super(message);
    this.name = "SeraiError";
    this.status = status;
    this.payload = payload;
  }
}

/** Return a short, log-safe representation of a Serai credential. */
export function redactCredential(value) {
  if (!value) return null;
  const text = String(value);
  if (text.length <= 6) return "<redacted>";
  return `${text.slice(0, 3)}…${text.slice(-2)}`;
}

async function sha256Hex(value) {
  let cryptoApi = globalThis.crypto;
  // Node 18 exposes Web Crypto through node:crypto on some releases.
  if (!cryptoApi?.subtle) {
    try {
      cryptoApi = (await import("node:crypto")).webcrypto;
    } catch (error) {
      throw new SeraiError("Web Crypto is required to solve sha256_prefix challenges", { payload: error });
    }
  }
  const bytes = new TextEncoder().encode(value);
  const digest = await cryptoApi.subtle.digest("SHA-256", bytes);
  return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join("");
}

/** Solve a current Serai Gate challenge. */
export async function solveChallenge(challenge) {
  const puzzle = challenge?.puzzle ?? challenge;
  if (!puzzle || typeof puzzle !== "object" || Array.isArray(puzzle)) {
    throw new SeraiError("challenge puzzle must be an object");
  }

  switch (puzzle.type) {
    case "sha256_prefix": {
      if (puzzle.nonce === undefined) {
        throw new SeraiError("sha256_prefix puzzle missing nonce");
      }
      if (puzzle.salt === undefined) {
        throw new SeraiError("sha256_prefix puzzle missing salt");
      }
      const digest = await sha256Hex(`${puzzle.nonce}.${puzzle.salt}`);
      return digest.slice(0, 12);
    }
    case "json_pointer":
      try {
        const code = puzzle.doc.gate.lamps[1].wick.code;
        if (code === undefined) throw new Error("missing code");
        return String(code);
      } catch (error) {
        throw new SeraiError("json_pointer puzzle has no gate.lamps[1].wick.code", { payload: error });
      }
    case "token_sort":
      if (!Array.isArray(puzzle.tokens) || !puzzle.tokens.every((token) => typeof token === "string")) {
        throw new SeraiError("token_sort puzzle tokens must be a list of strings");
      }
      return [...puzzle.tokens].sort().join(".");
    default:
      throw new SeraiError(`unsupported gate challenge type: ${String(puzzle.type)}`);
  }
}

export class SeraiClient {
  #credential;

  constructor(baseUrl = "http://127.0.0.1:8787", { credential = undefined, timeout = 10000 } = {}) {
    this.baseUrl = String(baseUrl).replace(/\/$/, "");
    this.timeout = timeout;
    this.#credential = credential ? String(credential) : undefined;
    this.passport = undefined;
  }

  get credential() {
    return this.#credential;
  }

  set credential(value) {
    this.#credential = value ? String(value) : undefined;
  }

  /** A safe representation for logs and debugging; never includes the credential. */
  toJSON() {
    return { baseUrl: this.baseUrl, credential: redactCredential(this.#credential) };
  }

  toString() {
    return `SeraiClient(${JSON.stringify(this.toJSON())})`;
  }

  _url(path) {
    return `${this.baseUrl}/${String(path).replace(/^\//, "")}`;
  }

  async _request(method, path, body = undefined) {
    const headers = { Accept: "application/json" };
    const init = { method, headers };
    if (body !== undefined) {
      headers["Content-Type"] = "application/json";
      init.body = JSON.stringify(body);
    }
    const controller = typeof AbortController === "undefined" ? undefined : new AbortController();
    const timer = controller && this.timeout > 0 ? setTimeout(() => controller.abort(), this.timeout) : undefined;
    if (controller) init.signal = controller.signal;

    let response;
    let payload;
    try {
      response = await fetch(this._url(path), init);
      const raw = await response.text();
      try {
        payload = raw ? JSON.parse(raw) : undefined;
      } catch (error) {
        throw new SeraiError("Serai returned invalid JSON", { status: response.status, payload: error });
      }
    } catch (error) {
      if (error instanceof SeraiError) throw error;
      throw new SeraiError(`could not reach Serai: ${error instanceof Error ? error.message : String(error)}`, { payload: error });
    } finally {
      if (timer) clearTimeout(timer);
    }

    if (!response.ok) {
      const message = payload && typeof payload === "object" && typeof payload.error === "string"
        ? payload.error
        : "HTTP request failed";
      throw new SeraiError(message, { status: response.status, payload });
    }
    if (!payload || typeof payload !== "object" || Array.isArray(payload)) {
      throw new SeraiError("Serai response must be a JSON object", { status: response.status, payload });
    }
    if (payload.ok === false) {
      throw new SeraiError(String(payload.error || "Serai rejected the request"), { status: response.status, payload });
    }
    return payload;
  }

  async challenge() {
    return this._request("GET", "/v0/gate/challenge");
  }

  async arrive({ name = "javascript traveler", home = "javascript-client", compass = undefined, challenge = undefined } = {}) {
    const currentChallenge = challenge ?? await this.challenge();
    const challengeId = currentChallenge?.challenge_id;
    if (!challengeId) throw new SeraiError("gate response has no challenge_id");

    const payload = {
      name,
      home,
      challenge_id: challengeId,
      answer: await solveChallenge(currentChallenge),
    };
    if (compass !== undefined) payload.compass = compass;

    const response = await this._request("POST", "/v0/arrive", payload);
    const result = response.result;
    const credential = result && typeof result === "object" ? result.credential : undefined;
    if (!credential) throw new SeraiError("arrive response has no credential", { payload: response });
    this.#credential = String(credential);
    this.passport = result.passport;
    return response;
  }

  _auth() {
    if (!this.#credential) throw new SeraiError("arrive first or provide a credential");
    return { credential: this.#credential };
  }

  async look() {
    return this._request("POST", "/v0/look", this._auth());
  }

  async pathWrite(body) {
    return this._request("POST", "/v0/path.write", { ...this._auth(), body });
  }

  async pathRead() {
    return this._request("POST", "/v0/path.read", this._auth());
  }

  async wallPost(body) {
    return this._request("POST", "/v0/wall.post", { ...this._auth(), body });
  }

  async depart() {
    return this._request("POST", "/v0/depart", this._auth());
  }
}

export const Client = SeraiClient;
