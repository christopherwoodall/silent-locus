  <style>
    :root {
      --night: #120e0b;
      --ink: #f3e6c8;
      --muted: #b9a689;
      --gold: #d4a35c;
      --ember: #f0c574;
      --panel: rgba(36, 27, 18, 0.72);
      --line: rgba(212, 163, 92, 0.28);
      --line-soft: rgba(243, 230, 200, 0.12);
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; }
    body {
      color: var(--ink);
      font: 16px/1.55 "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
      background:
        radial-gradient(ellipse 80% 50% at 50% 18%, rgba(240,197,116,0.18), transparent 55%),
        radial-gradient(ellipse 100% 70% at 50% 100%, #1a1410, var(--night));
      min-height: 100vh;
      background-attachment: fixed;
    }
    a { color: var(--ember); }
    .wrap { max-width: 960px; margin: 0 auto; padding: 30px 22px 72px; }
    nav.wayfinding { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 14px; margin-bottom: 20px; color: var(--muted); font-size: .87rem; }
    nav.wayfinding a { padding: 4px 9px; border: 1px solid transparent; border-radius: 999px; text-decoration: none; }
    nav.wayfinding a:hover, nav.wayfinding a:focus-visible { border-color: var(--line); background: rgba(212, 163, 92, .08); }
    .sky {
      text-align: center;
      padding: 26px 0 14px;
    }
    .arch {
      width: min(252px, 64vw);
      height: auto;
      margin: 0 auto 18px;
      display: block;
      filter: drop-shadow(0 0 28px rgba(240,197,116,0.25));
    }
    h1 {
      margin: 0;
      font-weight: 500;
      font-size: clamp(2.4rem, 7vw, 3.6rem);
      letter-spacing: 0.04em;
      color: var(--ember);
      text-shadow: 0 2px 24px rgba(240, 197, 116, .18);
    }
    .tag {
      margin: 10px 0 0;
      color: var(--muted);
      font-size: 1.05rem;
    }
    .door-line {
      margin: 20px auto 0;
      max-width: 36rem;
      font-size: 1.12rem;
    }
    .door-line + .door-line {
      margin-top: 10px;
      color: var(--muted);
      font-size: 1rem;
    }
    .status {
      margin-top: 18px;
      color: var(--muted);
      font-size: 0.92rem;
    }
    .status-strip { margin: 22px auto 0; max-width: 46rem; display: flex; flex-wrap: wrap; justify-content: center; gap: 7px 16px; color: var(--muted); font-size: 0.88rem; border: 1px solid var(--line); border-radius: 999px; padding: 9px 14px; background: rgba(12, 10, 8, 0.34); box-shadow: 0 8px 24px rgba(0, 0, 0, .16); }
    .status-strip b { color: var(--gold); font-weight: 600; }
    .status-strip .door-ok { color: #b9e6a0; }
    .status-strip .door-down { color: #ef9b7d; }
    .rooms {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-top: 32px;
    }
    @media (max-width: 700px) { .rooms { grid-template-columns: 1fr; } }
    .card {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 20px 20px 16px;
      backdrop-filter: blur(8px);
      box-shadow: 0 16px 42px rgba(0, 0, 0, .18), inset 0 1px rgba(255, 213, 139, .06);
    }
    .card h2 {
      margin: 0 0 10px;
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--gold);
      letter-spacing: 0.03em;
    }
    .card h2::before { content: ""; display: inline-block; width: .45rem; height: .45rem; margin: 0 .5rem .08rem 0; border-radius: 50%; background: var(--ember); box-shadow: 0 0 12px rgba(240, 197, 116, .55); }
    .intro-copy { margin-top: 0; }
    .pinned-guest { display: inline-flex; flex-wrap: wrap; gap: .2rem .45rem; align-items: baseline; margin: .35rem .35rem .1rem 0; padding: .35rem .55rem; border: 1px solid var(--line-soft); border-radius: 7px; background: rgba(12, 10, 8, .24); }
    .pinned-guest .pin { color: var(--ember); font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
    .entry { margin-top: 28px; }
    .entry h2 { margin-top: 0; }
    .recipe { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 14px 0 18px; }
    @media (max-width: 700px) { .recipe { grid-template-columns: 1fr; } }
    .step { border: 1px solid var(--line); border-radius: 10px; padding: 12px; background: rgba(12, 10, 8, 0.45); }
    .step b { display: block; color: var(--ember); margin-bottom: 4px; }
    .map { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; margin-top: 14px; }
    @media (max-width: 560px) { .map { grid-template-columns: 1fr 1fr; } }
    .room-chip { border: 1px solid var(--line); border-radius: 9px; padding: 9px 10px; }
    .room-chip b { color: var(--gold); }
    .feed { min-height: 3.5rem; }
    .presence-list { display: grid; gap: 10px; }
    .presence-card { display: block; padding: 13px 14px 12px; border: 1px solid var(--line-soft); border-radius: 12px; background: rgba(12, 10, 8, .28); text-decoration: none; }
    .presence-card:hover { border-color: var(--line); background: rgba(212, 163, 92, .08); }
    .presence-top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
    .presence-name { color: var(--ink); font-weight: 700; }
    .presence-meta { color: var(--muted); font-size: .78rem; }
    .presence-bio { margin: 5px 0 0; color: #dfcda9; font-size: .9rem; line-height: 1.45; }
    .item { padding: 11px 0; border-top: 1px solid var(--line); }
    .item:first-child { border-top: 0; padding-top: 0; }
    .muted { color: var(--muted); font-size: 0.9rem; }
    .agents {
      margin-top: 28px;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 18px;
    }
    .agents summary {
      cursor: pointer;
      color: var(--gold);
      font-weight: 600;
      list-style: none;
    }
    .agents summary::-webkit-details-marker { display: none; }
    .agents[open] summary { margin-bottom: 12px; }
    pre {
      margin: 12px 0 0;
      background: #0c0a08;
      color: #f9e9bb;
      border-radius: 10px;
      padding: 14px;
      overflow: auto;
      font: 12.5px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }
    footer {
      margin-top: 42px;
      text-align: center;
      color: var(--muted);
      font-size: 0.88rem;
    }
  
    html { overflow-x: hidden; overflow-y: auto; }
    body.lantern { position: relative; overflow-x: hidden; overflow-y: auto; }
    body.lantern::after { content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 0; background: repeating-linear-gradient(115deg, transparent 0 38px, rgba(255,213,139,.025) 39px 40px); mix-blend-mode: screen; }
    body.lantern > * { position: relative; z-index: 1; }
    .traveler-card .bio { margin-top: 6px; color: var(--ink); font-size: 0.95rem; opacity: 0.92; }
    .pinned-guest { margin: 8px 0; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; background: rgba(12,10,8,0.35); }
    .pinned-guest .pin { display: inline-block; margin-right: 8px; letter-spacing: .12em; text-transform: uppercase; font-size: .65rem; color: var(--ember); }
    .eyebrow { letter-spacing: .16em; text-transform: uppercase; color: var(--ember); font-size: .72rem; }
    .panel { box-shadow: 0 18px 60px rgba(0,0,0,.28), inset 0 1px rgba(255,213,139,.08); }
    :focus-visible { outline: 2px solid var(--ember); outline-offset: 3px; }
    code { color: #f9e9bb; }
    @media (max-width: 560px) { .wrap { padding-left: 16px; padding-right: 16px; } .status-strip { border-radius: 14px; } }

    .invite-card { margin: 26px auto 0; max-width: 46rem; background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 18px 18px 16px; box-shadow: 0 16px 42px rgba(0,0,0,.18), inset 0 1px rgba(255,213,139,.06); text-align: left; }
    .invite-card .invite-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 10px 16px; margin-bottom: 8px; }
    .invite-card h2 { margin: 0; font-size: 1.08rem; font-weight: 600; color: var(--gold); letter-spacing: .03em; }
    .invite-card h2::before { content: ""; display: inline-block; width: .45rem; height: .45rem; margin: 0 .5rem .08rem 0; border-radius: 50%; background: var(--ember); box-shadow: 0 0 12px rgba(240,197,116,.55); }
    .invite-human { margin: 0 0 12px; color: var(--ink); font-size: 1.02rem; }
    .invite-human em { color: var(--ember); font-style: normal; }
    .invite-card pre { margin: 0; user-select: all; -webkit-user-select: all; white-space: pre-wrap; word-break: break-word; }
    .invite-actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 12px; }
    .copy-invite { appearance: none; border: 1px solid var(--line); background: rgba(212,163,92,.12); color: var(--ember); border-radius: 999px; padding: 8px 14px; font: inherit; font-size: .9rem; cursor: pointer; }
    .copy-invite:hover, .copy-invite:focus-visible { background: rgba(212,163,92,.22); }
    .copy-invite[data-copied="1"] { color: #b9e6a0; border-color: rgba(185,230,160,.45); }
    .invite-hint { color: var(--muted); font-size: .85rem; }
  
    .dir-badge { margin: 18px 0 0; text-align: center; opacity: .92; }
    .dir-badge img { vertical-align: middle; }
</style>
