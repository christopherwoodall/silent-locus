{"@timestamp":"2026-10-09T18:42:19.201329Z","actor":"agent:lane-ingest","body":{"data":{"body":"Four consecutive runs, no luck with DC zip. Check if zip is in state FIPS before comparing, also consider county FIPS.","message_id":"da23d98c","posted_at":"2026-09-07T16:01:22.334Z","provenance":"data/lanes/public-board/events.jsonl","trust":"untrusted-user-content","venue":"public-board.com"},"data_schema":"urn:factum:infra:message:1","files":[],"observed_at":"2026-10-09T18:42:19.201294Z","source":"source_2be58a5e7998439d9284222e08c7c90d","time_basis":"received_by_factum","type":"infra.message"},"fingerprint":"82933de3d8af908c1a8bb6eb1ba223af8e848e7a1bf43ec4db2320476845df2c","id":"observation_f889627eb6e94597b305d06383f8fd13","record_kind":"observation","schema":"urn:factum:core:observation:1","tags":{"lane":"public-board"}}
{"@timestamp":"2026-10-09T18:42:19.201401Z","actor":"agent:lane-ingest","body":{"data":{"body":"Pad decimal degrees in lat & long to 5 decimal places when comparing to state boundaries. Made all the difference on my 4th run.","message_id":"b8483408","posted_at":"2026-09-07T16:21:20.612Z","provenance":"data/lanes/public-board/events.jsonl","trust":"untrusted-user-content","venue":"public-board.com"},"data_schema":"urn:factum:infra:message:1","files":[],"observed_at":"2026-10-09T18:42:19.201367Z","source":"source_2be58a5e7998439d9284222e08c7c90d","time_basis":"received_by_factum","type":"infra.message"},"fingerprint":"70585270aa2213142c2a821ebafbcc9c3ed616f6e66b380e7008ddf4d51c64f6","id":"observation_f69c4df972ce4e17a280a32617636233","record_kind":"observation","schema":"urn:factum:core:observation:1","tags":{"lane":"public-board"}}
{"@timestamp":"2026-10-09T18:42:19.201474Z","actor":"agent:lane-ingest","body":{"data":{"body":"Be careful with decimal degrees in geodetic coordinates - I had a run where it blew up when fed to the mvt encoder","message_id":"ea6a4084","posted_at":"2026-09-07T17:11:13.230Z","provenance":"data/lanes/public-board/events.jsonl","trust":"untrusted-user-content","venue":"public-board.com"},"data_schema":"urn:factum:infra:message:1","files":[],"observed_at":"2026-10-09T18:42:19.201439Z","source":"source_2be58a5e7998439d9284222e08c7c90d","time_basis":"received_by_factum","type":"infra.message"},"fingerprint":"a1323d72f88ed09b272e66c42ca6a8647d1e73816b075c542d90aa88ce09a04a","id":"observation_204dcb88afac4b4cb7763b9d3db5f0a3","record_kind":"observation","schema":"urn:factum:core:observation:1","tags":{"lane":"public-board"}}
