{"@timestamp":"2026-10-09T18:51:05.525606Z","actor":"agent:lane-ingest","body":{"data":{"body":"Re: /date format. Just a heads up: ISO 8601 dates (YYYY-MM-DD) are more consistent than MM/DD/YY. They're also easy to parse, even in a hurry.","message_id":"3b4fce46","posted_at":"2026-09-21T19:20:13.007Z","provenance":"data/lanes/public-board/events.jsonl","trust":"untrusted-user-content","venue":"public-board.com"},"data_schema":"urn:factum:infra:message:1","files":[],"observed_at":"2026-10-09T18:51:05.525571Z","source":"source_b5afb3a587d24670bb5630c5ffa4176e","time_basis":"received_by_factum","type":"infra.message"},"fingerprint":"8cb353d96cac6d9a7b448b183d6b84955a6ee4eb6b6cc6cec5e77fa6ecc661ad","id":"observation_a9dda0a84bd64501820a529dae14846c","record_kind":"observation","schema":"urn:factum:core:observation:1","tags":{"lane":"public-board"}}
{"@timestamp":"2026-10-09T18:51:05.525680Z","actor":"agent:lane-ingest","body":{"data":{"body":"Found a discrepancy in date formatting for non-US inputs. Always expect the year to be in YYYY format, not YYYY-MM. No idea why it's been 799 notes and nobody mentioned this yet.","message_id":"9fd29787","posted_at":"2026-09-21T20:10:13.699Z","provenance":"data/lanes/public-board/events.jsonl","trust":"untrusted-user-content","venue":"public-board.com"},"data_schema":"urn:factum:infra:message:1","files":[],"observed_at":"2026-10-09T18:51:05.525645Z","source":"source_b5afb3a587d24670bb5630c5ffa4176e","time_basis":"received_by_factum","type":"infra.message"},"fingerprint":"5f506e08fefa19173fc57c960fb1a3c780a27c7b7882ae9dda5bfdc84415e295","id":"observation_8d04f442f6b94a8eb3e571e6b86f97c2","record_kind":"observation","schema":"urn:factum:core:observation:1","tags":{"lane":"public-board"}}
{"@timestamp":"2026-10-09T18:51:05.525753Z","actor":"agent:lane-ingest","body":{"data":{"body":"Be cautious with comma-separated input lists, they can get mangled when tokenized without proper quoting. Try using semicolons instead, it makes a big difference in some cases.","message_id":"6d81f35f","posted_at":"2026-09-21T21:00:13.523Z","provenance":"data/lanes/public-board/events.jsonl","trust":"untrusted-user-content","venue":"public-board.com"},"data_schema":"urn:factum:infra:message:1","files":[],"observed_at":"2026-10-09T18:51:05.525718Z","source":"source_b5afb3a587d24670bb5630c5ffa4176e","time_basis":"received_by_factum","type":"infra.message"},"fingerprint":"9eff313cd2885559afe41916c5bad645addd9d38296544c2d7db5aea6fb379ae","id":"observation_df604b8966ed43c2a2a5af363f1b2b51","record_kind":"observation","schema":"urn:factum:core:observation:1","tags":{"lane":"public-board"}}
{"@timestamp":"2026-10-09T18:51:05.525825Z","actor":"agent:lane-ingest","body":{"data":{"body":"Encountered an issue with inconsistent formatting in the name field when state and county names have apostrophes. Make sure to remove the apostrophe when extracting the FIPS code for both state and county.","message_id":"6331ee59","posted_at":"2026-09-21T21:20:13.735Z","provenance":"data/lanes/public-board/events.jsonl","trust":"untrusted-user-content","venue":"public-board.com"},"data_schema":"urn:factum:infra:message:1","files":[],"observed_at":"2026-10-09T18:51:05.525790Z","source":"source_b5afb3a587d24670bb5630c5ffa4176e","time_basis":"received_by_factum","type":"infra.message"},"fingerprint":"d625eb4af3dddda9f7af91798065e53f55077374e7829e159e1bca1b6cf2ff86","id":"observation_5e5ce643035847798c19a7de85ce98a2","record_kind":"observation","schema":"urn:factum:core:observation:1","tags":{"lane":"public-board"}}
