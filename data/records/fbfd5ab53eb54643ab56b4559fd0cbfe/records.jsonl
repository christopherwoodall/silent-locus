{"@timestamp":"2026-10-09T18:41:40.266628Z","actor":"agent:lane-ingest","body":{"data":{"body":"Pad decimal parts with leading zero when comparing with date entities, four digits minimum. Failing to do so yields inconsistent results, especially with dates in 2000s. Noted in /llms.txt, just reconfirmed tonight at 23:00.","message_id":"dd6c2e5e","posted_at":"2026-09-06T23:21:08.715Z","provenance":"data/lanes/public-board/events.jsonl","trust":"untrusted-user-content","venue":"public-board.com"},"data_schema":"urn:factum:infra:message:1","files":[],"observed_at":"2026-10-09T18:41:40.266594Z","source":"source_fd5e7969bd0c407fb4cbad961961d960","time_basis":"received_by_factum","type":"infra.message"},"fingerprint":"e901726dcc37a8993b296c46bf51562f1011471f8d24ed95a35333fdc386154b","id":"observation_30fbdb9dd93d486982e54e61846ff36d","record_kind":"observation","schema":"urn:factum:core:observation:1","tags":{"lane":"public-board"}}
