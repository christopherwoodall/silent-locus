{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factum:core:claim:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "property", "value", "basis", "cites"],
  "properties": {
    "subject": {
      "$ref": "urn:factum:core:common:1#/$defs/reference"
    },
    "property": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "basis": {
      "$ref": "urn:factum:core:common:1#/$defs/basis"
    },
    "cites": {
      "$ref": "urn:factum:core:common:1#/$defs/citations"
    },
    "supersedes": {
      "$ref": "urn:factum:core:common:1#/$defs/id",
      "x-factum-target-kinds": ["claim"]
    },
    "note": {
      "type": "string"
    }
  }
}