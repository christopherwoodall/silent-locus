{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factum:core:edge:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "predicate", "object"],
  "properties": {
    "subject": {
      "$ref": "urn:factum:core:common:1#/$defs/reference"
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "object": {
      "$ref": "urn:factum:core:common:1#/$defs/reference"
    },
    "basis": {
      "$ref": "urn:factum:core:common:1#/$defs/basis"
    },
    "cites": {
      "$ref": "urn:factum:core:common:1#/$defs/citations"
    },
    "note": {
      "type": "string"
    }
  }
}