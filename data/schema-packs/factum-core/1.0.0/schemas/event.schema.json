{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factum:core:event:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "title",
    "occurred",
    "cites",
    "data_schema",
    "data"
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "occurred": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis"],
      "properties": {
        "basis": {
          "$ref": "urn:factum:core:common:1#/$defs/time_basis"
        },
        "start": {
          "$ref": "urn:factum:core:common:1#/$defs/time"
        },
        "end": {
          "$ref": "urn:factum:core:common:1#/$defs/time"
        },
        "on_date": {
          "type": "string",
          "format": "date"
        },
        "raw": {
          "type": "string"
        }
      }
    },
    "cites": {
      "$ref": "urn:factum:core:common:1#/$defs/citations"
    },
    "data_schema": {
      "type": "string",
      "format": "uri"
    },
    "data": {
      "type": "object"
    }
  }
}