{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factum:core:lane:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "kind",
    "parents",
    "created_at",
    "tags"
  ],
  "properties": {
    "schema": {
      "const": "urn:factum:core:lane:1"
    },
    "id": {
      "type": "string",
      "pattern": "^lane_[0-9a-f]{32}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "parents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:factum:core:common:1#/$defs/id",
        "x-factum-target-kinds": ["lane"]
      }
    },
    "created_at": {
      "$ref": "urn:factum:core:common:1#/$defs/time"
    },
    "tags": {
      "$ref": "urn:factum:core:common:1#/$defs/tags"
    }
  }
}