{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factum:core:observation:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "source",
    "observed_at",
    "time_basis",
    "files",
    "data_schema",
    "data"
  ],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "urn:factum:core:common:1#/$defs/id",
      "x-factum-target-kinds": ["source"]
    },
    "observed_at": {
      "$ref": "urn:factum:core:common:1#/$defs/time"
    },
    "time_basis": {
      "$ref": "urn:factum:core:common:1#/$defs/time_basis"
    },
    "run": {
      "$ref": "urn:factum:core:common:1#/$defs/id",
      "x-factum-target-kinds": ["run"]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact"],
        "properties": {
          "artifact": {
            "$ref": "urn:factum:core:common:1#/$defs/id",
            "x-factum-target-kinds": ["artifact"]
          },
          "role": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "tags": {
            "$ref": "urn:factum:core:common:1#/$defs/tags"
          }
        }
      }
    },
    "data_schema": {
      "type": "string",
      "format": "uri"
    },
    "data": {
      "type": "object"
    }
  }
}