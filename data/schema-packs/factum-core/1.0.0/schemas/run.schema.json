{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factum:core:run:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_kind"],
  "properties": {
    "run_kind": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string"
    },
    "tool_version": {
      "type": "string"
    },
    "started": {
      "$ref": "urn:factum:core:common:1#/$defs/time"
    },
    "ended": {
      "$ref": "urn:factum:core:common:1#/$defs/time"
    },
    "params": {
      "type": "object"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "scanned": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        }
      }
    }
  }
}