{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factum:core:assessment:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "question", "outcome", "scope", "cites"],
  "properties": {
    "subject": {
      "$ref": "urn:factum:core:common:1#/$defs/reference"
    },
    "question": {
      "enum": [
        "seen_before",
        "same_event",
        "novelty",
        "independence",
        "originality"
      ]
    },
    "outcome": {
      "enum": [
        "not_found",
        "duplicate",
        "same_value",
        "same_event",
        "corroborating",
        "update",
        "related",
        "contradicts",
        "copied",
        "independent",
        "novel_in_scope",
        "reported",
        "adjacent",
        "earliest_known",
        "uncertain"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_digest", "description"],
      "properties": {
        "state_digest": {
          "$ref": "urn:factum:core:common:1#/$defs/sha256"
        },
        "commit": {
          "type": ["string", "null"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "compared": {
      "type": "array",
      "items": {
        "$ref": "urn:factum:core:common:1#/$defs/reference"
      }
    },
    "cites": {
      "$ref": "urn:factum:core:common:1#/$defs/citations"
    },
    "rationale": {
      "type": "string"
    }
  }
}