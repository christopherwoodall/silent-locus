{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factum:core:bundle:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle", "idempotency_key", "actor", "records"],
  "properties": {
    "bundle": {
      "const": 2
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "$ref": "urn:factum:core:common:1#/$defs/tags"
    },
    "lane": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "path", "storage"],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "storage": {
            "enum": ["git", "local"]
          },
          "tags": {
            "$ref": "urn:factum:core:common:1#/$defs/tags"
          }
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "body"],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "kind": {
            "enum": [
              "source",
              "artifact",
              "observation",
              "observable",
              "sighting",
              "event",
              "claim",
              "edge",
              "assessment",
              "run",
              "retraction"
            ]
          },
          "body": {
            "type": "object"
          },
          "tags": {
            "$ref": "urn:factum:core:common:1#/$defs/tags"
          }
        }
      }
    }
  }
}