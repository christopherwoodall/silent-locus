{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factum:core:observable:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "value_schema", "value"],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "value_schema": {
      "type": "string",
      "format": "uri"
    },
    "value": {
      "type": "string"
    }
  }
}