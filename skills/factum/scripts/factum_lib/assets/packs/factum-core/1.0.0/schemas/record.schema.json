{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factum:core:record:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_kind",
    "id",
    "@timestamp",
    "actor",
    "tags",
    "body",
    "fingerprint"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "format": "uri"
    },
    "record_kind": {
      "enum": [
        "source",
        "artifact",
        "observation",
        "observable",
        "sighting",
        "event",
        "claim",
        "edge",
        "assessment",
        "run",
        "retraction"
      ]
    },
    "id": {
      "$ref": "urn:factum:core:common:1#/$defs/id"
    },
    "@timestamp": {
      "$ref": "urn:factum:core:common:1#/$defs/time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "$ref": "urn:factum:core:common:1#/$defs/tags"
    },
    "body": {
      "type": "object"
    },
    "fingerprint": {
      "$ref": "urn:factum:core:common:1#/$defs/sha256"
    }
  }
}