{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factum:datasets:snapshot:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_uri", "coverage"],
  "properties": {
    "dataset_uri": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string"
    },
    "coverage": {
      "enum": ["complete", "partial", "metadata_only", "unknown"]
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}