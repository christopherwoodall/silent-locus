{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factum:web:reachability-check:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "method", "outcome"],
  "properties": {
    "target": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "response",
        "dns_failure",
        "connect_failure",
        "tls_failure",
        "timeout",
        "blocked",
        "unknown"
      ]
    },
    "http_status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "error": {
      "type": "string"
    }
  }
}