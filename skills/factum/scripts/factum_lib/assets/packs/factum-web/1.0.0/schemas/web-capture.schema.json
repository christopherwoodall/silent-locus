{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factum:web:web-capture:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["requested_url", "capture_kind"],
  "properties": {
    "requested_url": {
      "type": "string"
    },
    "final_url": {
      "type": "string"
    },
    "capture_kind": {
      "enum": ["http", "browser", "screenshot", "warc", "submitted"]
    },
    "http_status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "tool": {
      "type": "string"
    },
    "headers": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string"},
          {"type": "string"}
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}